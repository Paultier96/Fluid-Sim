#pragma kernel Init
#pragma kernel MaskedGaussianHorizontal
#pragma kernel MaskedGaussianVertical

Texture2D<float4> SharpCausticsTex;
Texture2D<float4> CombinedTex;
Texture2D<float4> SoftLightRead;
RWTexture2D<float4> SoftLightWrite;
SamplerState linear_clamp_sampler;

int softLightWidth;
int softLightHeight;
int causticWidth;
int causticHeight;
int combinedWidth;
int combinedHeight;
float densityThreshold;
float edgeSoftness;
float phaseBlendWidth;
float phase0RenderBias;
float phaseBoundarySharpness;
float scatterStrengthA;
float scatterStrengthB;
float lightIntensity;
float gaussianRadius0;
float gaussianRadius1;
int useEllipticalBounds;
float2 ellipseBoundsCenter;
float2 ellipseBoundsSize;
float obstacleY;
float analyticBoundaryExpansion;
float2 softLightWorldCenter;
float2 softLightWorldSize;
float4 softLightSourceUvRect;

float2 UvFromPixel(uint2 pixel)
{
	return (float2(pixel) + 0.5) / max(float2(softLightWidth, softLightHeight), float2(1.0, 1.0));
}

float2 SourceUvFromSoftLightUv(float2 uv)
{
	return softLightSourceUvRect.xy + uv * softLightSourceUvRect.zw;
}

uint2 PixelFromUv(float2 uv, int width, int height)
{
	uint2 maxPixel = uint2((uint)max(width - 1, 0), (uint)max(height - 1, 0));
	return min((uint2)(saturate(uv) * float2(width, height)), maxPixel);
}

float4 SampleSharpCaustics(uint2 pixel)
{
	float2 uv = UvFromPixel(pixel);
	return SharpCausticsTex.SampleLevel(linear_clamp_sampler, uv, 0);
}

float4 SampleCombinedAt(uint2 pixel)
{
	float2 uv = UvFromPixel(pixel);
	return CombinedTex.SampleLevel(linear_clamp_sampler, SourceUvFromSoftLightUv(uv), 0);
}

float2 PhaseDensities(uint2 pixel)
{
	float4 combined = SampleCombinedAt(pixel);
	return float2(combined.g, combined.a);
}

uint2 ClampPixel(int2 pixel)
{
	return (uint2)clamp(pixel, int2(0, 0), int2(softLightWidth - 1, softLightHeight - 1));
}

float2 WorldPosFromUv(float2 uv)
{
	return softLightWorldCenter + (uv - 0.5) * max(softLightWorldSize, float2(0.0001, 0.0001));
}

float2 BoundaryDistances(float2 worldPos)
{
	float2 radii = max(abs(ellipseBoundsSize), 0.0001);
	float2 rel = worldPos - ellipseBoundsCenter;
	float2 q = rel / radii;
	float qLen = max(length(q), 0.0001);
	float ellipseGradientLength = length(float2(q.x / radii.x, q.y / radii.y)) / qLen;
	float ellipseDistance = (qLen - 1.0) / max(ellipseGradientLength, 0.0001);
	float cutDistance = obstacleY - worldPos.y;
	return float2(ellipseDistance, cutDistance);
}

float OuterAnalyticBoundaryDistance(float2 worldPos)
{
	float2 distances = BoundaryDistances(worldPos);
	float outsideDistance = length(max(distances, 0.0)) + min(max(distances.x, distances.y), 0.0);
	return outsideDistance - max(analyticBoundaryExpansion, 0.0);
}

float PhaseRatio(float2 densities)
{
	float totalDensity = densities.x + densities.y;
	return densities.y / max(totalDensity, 0.00001);
}

float PhaseT(uint2 pixel, float2 densities)
{
	float totalDensity = densities.x + densities.y;
	float phaseRatio = PhaseRatio(densities);
	float phaseBoundary = saturate(0.5 + phase0RenderBias * 0.5);
	if (totalDensity < densityThreshold)
	{
		return phaseRatio;
	}

	int2 pixelI = int2(pixel);
	float phaseRatioRight = PhaseRatio(PhaseDensities(ClampPixel(pixelI + int2(1, 0))));
	float phaseRatioLeft = PhaseRatio(PhaseDensities(ClampPixel(pixelI + int2(-1, 0))));
	float phaseRatioUp = PhaseRatio(PhaseDensities(ClampPixel(pixelI + int2(0, 1))));
	float phaseRatioDown = PhaseRatio(PhaseDensities(ClampPixel(pixelI + int2(0, -1))));
	float phaseGradient = abs(phaseRatioRight - phaseRatioLeft) + abs(phaseRatioUp - phaseRatioDown);
	float phaseAA = max(0.25 * phaseGradient * max(phaseBlendWidth, 0.0001), 0.00001);
	return smoothstep(-phaseAA, phaseAA, phaseRatio - phaseBoundary);
}

float2 PhaseWeights(uint2 pixel, float2 densities)
{
	float phaseT = PhaseT(pixel, densities);
	return float2(1.0 - phaseT, phaseT);
}

float OuterAlpha(uint2 pixel, float2 densities)
{
	float density = max(densities.x, densities.y);
	float particleAlpha = smoothstep(max(densityThreshold - edgeSoftness, 0.0), densityThreshold + edgeSoftness, density);
	if (useEllipticalBounds == 0)
	{
		return particleAlpha;
	}

	float2 uv = UvFromPixel(pixel);
	float boundsDistance = OuterAnalyticBoundaryDistance(WorldPosFromUv(uv));
	float2 worldTexel = max(softLightWorldSize / max(float2(softLightWidth, softLightHeight), float2(1.0, 1.0)), float2(0.0001, 0.0001));
	float boundsAA = max(max(worldTexel.x, worldTexel.y), 0.0001);
	float boundsAlpha = smoothstep(boundsAA, -boundsAA, boundsDistance);
	return min(particleAlpha, boundsAlpha);
}

float2 PhaseVisibleMasks(uint2 pixel, float2 densities)
{
	return PhaseWeights(pixel, densities) * OuterAlpha(pixel, densities);
}

float PhaseConductance(float centerPhase, float neighborPhase)
{
	return exp(-abs(centerPhase - neighborPhase) * max(phaseBoundarySharpness, 0.0));
}

float4 SampleSoftLight(uint2 pixel)
{
	return SoftLightRead.Load(int3(pixel, 0));
}

float Gaussian(float x, float sigma)
{
	return exp(-(x * x) / max(2.0 * sigma * sigma, 0.0001));
}

float PhaseGaussianRadius(float phase)
{
	return lerp(max(gaussianRadius0, 0.0), max(gaussianRadius1, 0.0), saturate(phase));
}

float4 MaskedGaussianHorizontalLight(uint2 pixel)
{
	float2 centerDensities = PhaseDensities(pixel);
	float2 centerMasks = PhaseVisibleMasks(pixel, centerDensities);
	float centerPhase = centerMasks.y / max(centerMasks.x + centerMasks.y, 0.00001);
	float radius = PhaseGaussianRadius(centerPhase);
	int tapRadius = min((int)ceil(radius), 64);
	float sigma = max(radius / 2.5, 0.001);

	float3 numerator = 0.0;
	float denominator = 0.0;
	int2 pixelI = int2(pixel);
	for (int tap = -64; tap <= 64; tap++)
	{
		if (abs(tap) > tapRadius)
		{
			continue;
		}

		uint2 tapPixel = ClampPixel(pixelI + int2(tap, 0));
		float2 tapDensities = PhaseDensities(tapPixel);
		float2 tapMasks = PhaseVisibleMasks(tapPixel, tapDensities);
		float tapMask = saturate(tapMasks.x + tapMasks.y);
		float tapPhase = tapMasks.y / max(tapMasks.x + tapMasks.y, 0.00001);
		float weight = Gaussian((float)tap, sigma) * PhaseConductance(centerPhase, tapPhase);
		float3 source = SampleSoftLight(tapPixel).rgb;
		numerator += source * weight;
		denominator += tapMask * weight;
	}

	return float4(numerator, denominator);
}

float4 MaskedGaussianVerticalLight(uint2 pixel)
{
	float2 centerDensities = PhaseDensities(pixel);
	float2 centerMasks = PhaseVisibleMasks(pixel, centerDensities);
	float centerMask = saturate(centerMasks.x + centerMasks.y);
	float centerPhase = centerMasks.y / max(centerMasks.x + centerMasks.y, 0.00001);
	float radius = PhaseGaussianRadius(centerPhase);
	int tapRadius = min((int)ceil(radius), 64);
	float sigma = max(radius / 2.5, 0.001);

	float3 numerator = 0.0;
	float denominator = 0.0;
	int2 pixelI = int2(pixel);
	for (int tap = -64; tap <= 64; tap++)
	{
		if (abs(tap) > tapRadius)
		{
			continue;
		}

		uint2 tapPixel = ClampPixel(pixelI + int2(0, tap));
		float2 tapDensities = PhaseDensities(tapPixel);
		float2 tapMasks = PhaseVisibleMasks(tapPixel, tapDensities);
		float tapPhase = tapMasks.y / max(tapMasks.x + tapMasks.y, 0.00001);
		float phaseWeight = PhaseConductance(centerPhase, tapPhase);
		float4 horizontal = SampleSoftLight(tapPixel);
		float weight = Gaussian((float)tap, sigma) * phaseWeight;
		numerator += horizontal.rgb * weight;
		denominator += horizontal.a * weight;
	}

	float3 normalized = denominator > 0.00001 ? numerator / denominator : 0.0;
	return float4(normalized * centerMask, centerPhase);
}

[numthreads(16, 16, 1)]
void Init(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= softLightWidth || id.y >= softLightHeight)
	{
		return;
	}

	uint2 pixel = id.xy;
	float2 densities = PhaseDensities(pixel);
	float2 masks = PhaseVisibleMasks(pixel, densities);
	float3 caustics = SampleSharpCaustics(pixel).rgb;
	float totalMask = max(masks.x + masks.y, 0.00001);
	float phaseT = masks.y / totalMask;
	float scatterStrength = lerp(max(scatterStrengthA, 0.0), max(scatterStrengthB, 0.0), phaseT) * max(lightIntensity, 0.0);
	SoftLightWrite[pixel] = float4(caustics * saturate(masks.x + masks.y) * scatterStrength, phaseT);
}

[numthreads(16, 16, 1)]
void MaskedGaussianHorizontal(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= softLightWidth || id.y >= softLightHeight)
	{
		return;
	}

	uint2 pixel = id.xy;
	SoftLightWrite[pixel] = MaskedGaussianHorizontalLight(pixel);
}

[numthreads(16, 16, 1)]
void MaskedGaussianVertical(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= softLightWidth || id.y >= softLightHeight)
	{
		return;
	}

	uint2 pixel = id.xy;
	SoftLightWrite[pixel] = MaskedGaussianVerticalLight(pixel);
}
