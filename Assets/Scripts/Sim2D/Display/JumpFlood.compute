// Jump Flooding Algorithm (JFA) compute shader
// Seeds a texture with per-pixel nearest-site data (pos.xy, tempNorm, phase)
// Then performs jump-flood passes to propagate nearest-site info.

#pragma kernel Clear
#pragma kernel Seed
#pragma kernel JumpFlood

// Buffers from simulation
StructuredBuffer<float2> Positions2D;
StructuredBuffer<float2> DensityData;
StructuredBuffer<float> Temperatures;
StructuredBuffer<float2> DebugData;
StructuredBuffer<int> Phases;
StructuredBuffer<uint> BlobIDs;
int _ParticleCount;

// Simulation bounds -> map world pos to [0,1]
float2 _SimMin;
float2 _SimMax;
matrix _VP;

// Temperature mapping
float _TempMin;
float _TempMax;
float debugGradientMax;
float debugCurvatureMax;
float debugViscosityMax;
float debugDensityMin;
float debugDensityMax;
int debugShowClipping;
int useLinearColorSpace;
int debugMode;

// Texture dimensions
int _Width;
int _Height;

// Jump step
int _Step;

// Textures
RWTexture2D<float4> Result;       // used by Clear and Seed (write)
RWTexture2D<float4> ResultPayload;
RWTexture2D<float4> ResultNormalPayload;
Texture2D<float4> _SrcTex;        // read-only source for JumpFlood
Texture2D<float4> _SrcPayloadTex;
Texture2D<float4> _SrcNormalPayloadTex;
RWTexture2D<float4> _DstTex;      // write destination for JumpFlood
RWTexture2D<float4> _DstPayloadTex;
RWTexture2D<float4> _DstNormalPayloadTex;
Texture2D<float4> ColourMap;
Texture2D<float4> ColourMap2;
Texture2D<float4> DebugHeatMap;
Texture2D<float4> DebugSignedHeatMap;

[numthreads(16,16,1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    int2 pix = int2(id.xy);
    if (pix.x >= _Width || pix.y >= _Height) return;
    // sentinel: w < 0 means no site
    Result[pix] = float4(-1.0, -1.0, 0.0, -1.0);
    ResultPayload[pix] = float4(0.0, 0.0, 0.0, -1.0);
    ResultNormalPayload[pix] = float4(0.5, 0.5, 1.0, -1.0);
}

float3 SampleGradient(Texture2D<float4> gradientTex, float t)
{
    uint width;
    uint height;
    gradientTex.GetDimensions(width, height);
    float x = saturate(t) * max((int)width - 1, 0);
    int x0 = (int)floor(x);
    int x1 = min(x0 + 1, (int)width - 1);
    float3 c0 = gradientTex.Load(int3(x0, 0, 0)).rgb;
    float3 c1 = gradientTex.Load(int3(x1, 0, 0)).rgb;
    return lerp(c0, c1, frac(x));
}

float3 ApplyHeatMapClipMarker(float t, float3 colour)
{
    if (debugShowClipping == 0)
    {
        return colour;
    }

    if (t < 0.0)
    {
        return float3(0.0, 1.0, 1.0);
    }
    if (t > 1.0)
    {
        return float3(1.0, 0.0, 1.0);
    }
    return colour;
}

float3 GammaToLinear(float3 colour)
{
    return float3(
        colour.r <= 0.04045 ? colour.r / 12.92 : pow((colour.r + 0.055) / 1.055, 2.4),
        colour.g <= 0.04045 ? colour.g / 12.92 : pow((colour.g + 0.055) / 1.055, 2.4),
        colour.b <= 0.04045 ? colour.b / 12.92 : pow((colour.b + 0.055) / 1.055, 2.4)
    );
}

float3 DebugColourToOutput(float3 colour)
{
    return useLinearColorSpace != 0 ? GammaToLinear(colour) : colour;
}

float3 HashBlobColor(uint blobId)
{
    if (blobId == 0xFFFFFFFFu)
    {
        return float3(0, 0, 0);
    }

    uint hueSlot = blobId * 7u;
    uint tier = blobId / 12u;
    float hue = frac((hueSlot % 12u) / 12.0 + (tier + 1u) * 0.0527864045);
    float saturation = 0.86 + 0.10 * frac(tier * 0.318309886);
    float value = 0.82 + 0.18 * frac(tier * 0.754877666 + 0.31);
    float3 rgb = saturate(abs(frac(hue + float3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0);
    return value * lerp(float3(1.0, 1.0, 1.0), rgb, saturation);
}

float3 ResolveSeedColor(int i, float tempNorm, float phase)
{
    if (debugMode == 0)
    {
        return phase == 0.0 ? SampleGradient(ColourMap, saturate(tempNorm)) : SampleGradient(ColourMap2, saturate(tempNorm));
    }

    float2 debugData = DebugData[i];
    if (debugMode == 1)
    {
        float2 normalizedDebugData = debugData / 7.0;
        float normalLenSq = dot(normalizedDebugData, normalizedDebugData);
        float3 normal = float3(normalizedDebugData, 1.0);
        float3 encodedNormal = saturate(0.5 + normal / 2.0);
        float clipped = debugShowClipping != 0 ? step(1.0, normalLenSq) : 0.0;
        return DebugColourToOutput(lerp(encodedNormal, float3(0.0, 1.0, 0.0), clipped));
    }

    if (debugMode == 2)
    {
        float t = debugData.x / max(debugCurvatureMax, 0.0001);
        float heatT = 0.5 + t * 0.5;
        return ApplyHeatMapClipMarker(heatT, SampleGradient(DebugSignedHeatMap, saturate(heatT)));
    }

    if (debugMode == 3)
    {
        float t = debugData.x / max(debugViscosityMax, 0.0001);
        return ApplyHeatMapClipMarker(t, SampleGradient(DebugHeatMap, saturate(t)));
    }

    if (debugMode == 4)
    {
        float density = DensityData[i].x;
        float t = (density - debugDensityMin) / max(debugDensityMax - debugDensityMin, 0.0001);
        return ApplyHeatMapClipMarker(t, SampleGradient(DebugHeatMap, saturate(t)));
    }

    if (debugMode == 5)
    {
        return ApplyHeatMapClipMarker(tempNorm, SampleGradient(DebugHeatMap, saturate(tempNorm)));
    }

    if (debugMode == 6)
    {
        return HashBlobColor(BlobIDs[i]);
    }

    return float3(0.0, 0.0, 0.0);
}

float3 ResolveSeedNormal(int i)
{
    float2 normalXY = DebugData[i] / 7.0;
    return saturate(float3(normalXY, 1.0) * 0.5 + 0.5);
}

// Seed: one thread per particle. writes seed data into the pixel corresponding to the particle's position.
[numthreads(64,1,1)]
void Seed(uint3 id : SV_DispatchThreadID)
{
    int i = int(id.x);
    if (i >= _ParticleCount) return;

    float2 p = Positions2D[i];
    float4 clip = mul(_VP, float4(p, 0, 1));
    float2 ndc = clip.xy / clip.w;        // -1 to 1
    float2 uv = ndc * 0.5 + 0.5;          // 0 to 1

    // clamp uv
    if (uv.x < 0 || uv.x > 1 || uv.y < 0 || uv.y > 1) return;

    int2 coord = int2(uv.x * (_Width - 1), uv.y * (_Height - 1));

    float tnorm = 0.0;
    if (_TempMax > _TempMin) tnorm = (Temperatures[i] - _TempMin) / (_TempMax - _TempMin);

    float phase = (float)Phases[i];

    // store: xy = seed position in pixel space, z = tempNorm, w = phase
    Result[coord] = float4((float)coord.x, (float)coord.y, tnorm, phase);
    ResultPayload[coord] = float4(ResolveSeedColor(i, tnorm, phase), 1.0);
    ResultNormalPayload[coord] = float4(ResolveSeedNormal(i), 1.0);
}

[numthreads(16,16,1)]
void JumpFlood(uint3 id : SV_DispatchThreadID)
{
    int2 pix = int2(id.xy);
    if (pix.x >= _Width || pix.y >= _Height) return;

    float2 p = float2(pix);

    // read current seed data at this pixel
    float4 best = _SrcTex.Load(int3(pix, 0));
    float4 bestPayload = _SrcPayloadTex.Load(int3(pix, 0));
    float4 bestNormalPayload = _SrcNormalPayloadTex.Load(int3(pix, 0));
    float bestDist = 1e20;
    if (best.w >= 0.0)
    {
        float2 d = p - best.xy;
        bestDist = dot(d, d);
    }

    // sample neighbours at offsets of _Step
    for (int oy = -1; oy <= 1; oy++)
    {
        for (int ox = -1; ox <= 1; ox++)
        {
            int2 n = pix + int2(ox * _Step, oy * _Step);
            if (n.x < 0 || n.y < 0 || n.x >= _Width || n.y >= _Height) continue;
            float4 cand = _SrcTex.Load(int3(n, 0));
            if (cand.w < 0.0) continue;
            float2 dd = p - cand.xy;
            float d2 = dot(dd, dd);
            if (d2 < bestDist)
            {
                bestDist = d2;
                best = cand;
                bestPayload = _SrcPayloadTex.Load(int3(n, 0));
                bestNormalPayload = _SrcNormalPayloadTex.Load(int3(n, 0));
            }
        }
    }

    _DstTex[pix] = best;
    _DstPayloadTex[pix] = bestPayload;
    _DstNormalPayloadTex[pix] = bestNormalPayload;
}
