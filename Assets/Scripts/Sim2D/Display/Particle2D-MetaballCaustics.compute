#pragma kernel Clear
#pragma kernel Trace
#pragma kernel Resolve

Texture2D<float4> CombinedTex;
Texture2D<float4> VelocityTex0;
Texture2D<float4> VelocityTex1;
Texture2D<float4> ColourMap;
Texture2D<float4> ColourMap2;
RWStructuredBuffer<uint> CausticAccum;
RWStructuredBuffer<int> CausticMotionAccum;
RWStructuredBuffer<uint> LightDirectionAccum;
RWTexture2D<float4> CausticResult;
RWTexture2D<float4> CausticMotionResult;
RWTexture2D<float4> LightDirectionResult;

static const float CausticMotionWeightScale = 1048576.0;
static const float CausticMotionValueScale = 1048576.0;

int combinedWidth;
int combinedHeight;
int causticWidth;
int causticHeight;
int causticsRayCount;
float causticsRayStartOffset;
float causticsRaySpacing;
int causticsPhase = 0;
int causticsRaySteps;
int causticsRayStride;
int causticsRaysPerPixel;
int causticsColourSampleStride;
int causticsMotionEnabled;
int causticsDirectionalLightFieldEnabled;
int causticsStochasticReflection;
int causticsFrameIndex;
float densityThreshold;
float phase0RenderBias;
float causticsStepPixels;
float causticsGlassIndexOfRefraction;
float causticsGlassReflectance;
float causticsPhase0IndexOfRefraction;
float causticsPhase1IndexOfRefraction;
float causticsDispersionStrength;
float causticsDispersionRotation;
float causticsPhase0Reflectance;
float causticsPhase1Reflectance;
float causticsPhase0Metallic;
float causticsPhase1Metallic;
float causticsFresnelStrength;
float causticsLightAngularRadius;
float causticsPhase0Absorption;
float causticsPhase1Absorption;
float3 causticsPhase0AbsorptionTint;
float3 causticsPhase1AbsorptionTint;
float causticsPhase0AbsorptionTintBlend;
float causticsPhase1AbsorptionTintBlend;
float causticsAbsorptionAlbedoBrightnessInfluence;
float causticsAbsorptionAlbedoSaturationInfluence;
float causticsRayBrightness;
float causticsTemporalJitterPixels;
float causticsSurfaceNormalJitterPixels;
float causticsDeltaTime;
float3 causticsLightDirection;
int useEllipticalBounds;
float2 ellipseBoundsCenter;
float2 ellipseBoundsSize;
float obstacleY;
float analyticBoundaryExpansion;
float2 causticsWorldCenter;
float2 causticsWorldSize;

float4 LoadCombinedPixel(int2 pixel)
{
	pixel = clamp(pixel, int2(0, 0), int2(combinedWidth - 1, combinedHeight - 1));
	return CombinedTex.Load(int3(pixel, 0));
}

float4 SampleCombined(float2 uv)
{
	int2 pixel = (int2)round(saturate(uv) * float2(combinedWidth - 1, combinedHeight - 1));
	return LoadCombinedPixel(pixel);
}

int2 VelocityPixel(float2 uv)
{
	int2 pixel = (int2)round(saturate(uv) * float2(combinedWidth - 1, combinedHeight - 1));
	return clamp(pixel, int2(0, 0), int2(combinedWidth - 1, combinedHeight - 1));
}

bool InsideTexture(float2 uv)
{
	return all(uv >= 0.0) && all(uv <= 1.0);
}

uint AccumIndex(int2 pixel)
{
	return (uint)((pixel.y * causticWidth + pixel.x) * 4);
}

float MaxPhaseDensity(float4 combined)
{
	return max(combined.g, combined.a);
}

float PhaseRatio(float4 combined)
{
	return combined.a / max(combined.g + combined.a, 0.0001);
}

float PhaseBoundary()
{
	return saturate(0.5 + phase0RenderBias * 0.5);
}

float SelectedDensity(float4 combined)
{
	if (MaxPhaseDensity(combined) < densityThreshold)
	{
		return 0.0;
	}

	float phaseDelta = causticsPhase == 0
		? PhaseBoundary() - PhaseRatio(combined)
		: PhaseRatio(combined) - PhaseBoundary();
	return densityThreshold + phaseDelta;
}

float DensityAt(float2 uv)
{
	if (!InsideTexture(uv))
	{
		return 0.0;
	}

	return SelectedDensity(SampleCombined(uv));
}

int PhaseFromCombined(float4 combined)
{
	if (MaxPhaseDensity(combined) < densityThreshold)
	{
		return -1;
	}

	return PhaseRatio(combined) < PhaseBoundary() ? 0 : 1;
}

float4 LoadPhaseVelocityPacked(int2 pixel, int phase)
{
	pixel = clamp(pixel, int2(0, 0), int2(combinedWidth - 1, combinedHeight - 1));
	return phase == 0
		? VelocityTex0.Load(int3(pixel, 0))
		: VelocityTex1.Load(int3(pixel, 0));
}

float4 SamplePhaseVelocityPackedNeighborhood(int2 pixel, int phase, int radius)
{
	float4 packedVelocity = 0.0;
	[loop]
	for (int y = -radius; y <= radius; y++)
	{
		[loop]
		for (int x = -radius; x <= radius; x++)
		{
			int distance = abs(x) + abs(y);
			float sampleWeight = 1.0 / (1.0 + (float)distance);
			packedVelocity += LoadPhaseVelocityPacked(pixel + int2(x, y), phase) * sampleWeight;
		}
	}

	return packedVelocity;
}

float2 SamplePhaseVelocity(float2 uv, int phase)
{
	int2 pixel = VelocityPixel(uv);
	float4 packedVelocity = SamplePhaseVelocityPackedNeighborhood(pixel, phase, 1);
	if (packedVelocity.b <= 0.0001)
	{
		packedVelocity = SamplePhaseVelocityPackedNeighborhood(pixel, phase, 3);
	}

	return packedVelocity.b > 0.0001 ? packedVelocity.rg / packedVelocity.b : 0.0;
}

int PhaseAt(float2 uv)
{
	return InsideTexture(uv) ? PhaseFromCombined(SampleCombined(uv)) : -1;
}

float3 SampleColourMap(Texture2D<float4> colourMap, float t)
{
	uint width;
	uint height;
	colourMap.GetDimensions(width, height);
	float2 pixel = float2(saturate(t) * max((float)width - 1.0, 0.0), 0.5 * max((float)height - 1.0, 0.0));
	int2 p00 = (int2)floor(pixel);
	int2 p10 = p00 + int2(1, 0);
	float f = pixel.x - p00.x;
	p00 = clamp(p00, int2(0, 0), int2((int)width - 1, (int)height - 1));
	p10 = clamp(p10, int2(0, 0), int2((int)width - 1, (int)height - 1));
	return lerp(colourMap.Load(int3(p00, 0)).rgb, colourMap.Load(int3(p10, 0)).rgb, f);
}

float3 RayColourFromCombined(float4 combined, int phase)
{
	float3 colour = 1.0;
	if (phase == 0)
	{
		float data = combined.r / max(combined.g, 0.0001);
		colour = SampleColourMap(ColourMap, data);
	}
	else if (phase == 1)
	{
		float data = combined.b / max(combined.a, 0.0001);
		colour = SampleColourMap(ColourMap2, data);
	}

	float maxChannel = max(max(colour.r, colour.g), colour.b);
	if (maxChannel <= 0.0001)
	{
		return float3(1.0, 1.0, 1.0);
	}

	float targetMax = sqrt(saturate(maxChannel));
	float3 boostedColour = colour * (targetMax / maxChannel);
	return max(boostedColour, targetMax * 0.03);
}

float3 AbsorptionColourFromCombined(float4 combined, int phase)
{
	float3 albedoColour = RayColourFromCombined(combined, phase);
	float maxChannel = max(max(albedoColour.r, albedoColour.g), albedoColour.b);
	float3 hueColour = maxChannel > 0.0001 ? albedoColour / maxChannel : float3(1.0, 1.0, 1.0);
	if (phase == 0)
	{
		float brightness = lerp(1.0, maxChannel, saturate(causticsAbsorptionAlbedoBrightnessInfluence));
		float luminance = dot(hueColour, float3(0.2126, 0.7152, 0.0722));
		float3 controlledHue = lerp(float3(luminance, luminance, luminance), hueColour, saturate(causticsAbsorptionAlbedoSaturationInfluence));
		float3 brightnessControlledAlbedo = controlledHue * brightness;
		return lerp(brightnessControlledAlbedo, max(causticsPhase0AbsorptionTint, 0.0), saturate(causticsPhase0AbsorptionTintBlend));
	}
	if (phase == 1)
	{
		float brightness = lerp(1.0, maxChannel, saturate(causticsAbsorptionAlbedoBrightnessInfluence));
		float luminance = dot(hueColour, float3(0.2126, 0.7152, 0.0722));
		float3 controlledHue = lerp(float3(luminance, luminance, luminance), hueColour, saturate(causticsAbsorptionAlbedoSaturationInfluence));
		float3 brightnessControlledAlbedo = controlledHue * brightness;
		return lerp(brightnessControlledAlbedo, max(causticsPhase1AbsorptionTint, 0.0), saturate(causticsPhase1AbsorptionTintBlend));
	}

	return albedoColour;
}

float3 RayColourAt(float2 uv)
{
	if (!InsideTexture(uv))
	{
		return 1.0;
	}

	float4 combined = SampleCombined(uv);
	return RayColourFromCombined(combined, PhaseFromCombined(combined));
}

float2 DensityGradient(float2 uv)
{
	float2 texel = 1.0 / float2(max(combinedWidth, 1), max(combinedHeight, 1));
	float dx = DensityAt(uv + float2(texel.x, 0.0)) - DensityAt(uv - float2(texel.x, 0.0));
	float dy = DensityAt(uv + float2(0.0, texel.y)) - DensityAt(uv - float2(0.0, texel.y));
	return float2(dx, dy);
}

float2 SurfaceNormal(float2 uv, float2 rayDir)
{
	float2 gradient = DensityGradient(uv);
	float2 normal = length(gradient) > 0.000001 ? -normalize(gradient) : -normalize(rayDir + 0.0001);
	return dot(rayDir, normal) > 0.0 ? -normal : normal;
}

float2 UvToWorld(float2 uv)
{
	return causticsWorldCenter + (uv - 0.5) * causticsWorldSize;
}

float2 BoundaryDistances(float2 worldPos)
{
	float2 radii = max(abs(ellipseBoundsSize), 0.0001);
	float2 rel = worldPos - ellipseBoundsCenter;
	float2 q = rel / radii;
	float qLen = max(length(q), 0.0001);
	float ellipseGradientLength = length(float2(q.x / radii.x, q.y / radii.y)) / qLen;
	float ellipseDistance = (qLen - 1.0) / max(ellipseGradientLength, 0.0001);
	float cutDistance = obstacleY - worldPos.y;
	return float2(ellipseDistance, cutDistance);
}

float OffsetBoundaryDistance(float2 distances, float expansion)
{
	if (expansion <= 0.0001)
	{
		return max(distances.x, distances.y);
	}

	float outsideDistance = length(max(distances, 0.0)) + min(max(distances.x, distances.y), 0.0);
	return outsideDistance - expansion;
}

float InnerAnalyticBoundaryDistance(float2 worldPos)
{
	float2 distances = BoundaryDistances(worldPos);
	return max(distances.x, distances.y);
}

float OuterAnalyticBoundaryDistance(float2 worldPos)
{
	return OffsetBoundaryDistance(BoundaryDistances(worldPos), max(analyticBoundaryExpansion, 0.0));
}

bool InsideOuterAnalyticBoundary(float2 uv)
{
	return useEllipticalBounds == 0 || OuterAnalyticBoundaryDistance(UvToWorld(uv)) <= 0.0;
}

bool InsideInnerAnalyticBoundary(float2 uv)
{
	return useEllipticalBounds == 0 || InnerAnalyticBoundaryDistance(UvToWorld(uv)) <= 0.0;
}

int MediumPhaseFromCombined(float4 combined, bool insideFluidBoundary)
{
	int phase = PhaseFromCombined(combined);
	return phase >= 0 || useEllipticalBounds == 0 || !insideFluidBoundary ? phase : 1;
}

float2 EllipseBoundaryNormal(float2 worldPos)
{
	float2 radii = max(abs(ellipseBoundsSize), 0.0001);
	float2 rel = worldPos - ellipseBoundsCenter;
	float2 q = rel / radii;
	return length(q) > 0.0001
		? normalize(float2(q.x / radii.x, q.y / radii.y))
		: float2(0.0, 1.0);
}

float2 AnalyticBoundaryNormal(float2 worldPos)
{
	float2 distances = BoundaryDistances(worldPos);
	float2 ellipseNormal = EllipseBoundaryNormal(worldPos);
	float2 cutNormal = float2(0.0, -1.0);
	return distances.x > distances.y ? ellipseNormal : cutNormal;
}

float2 OffsetBoundaryNormal(float2 worldPos, float expansion)
{
	if (expansion <= 0.0001)
	{
		return AnalyticBoundaryNormal(worldPos);
	}

	float2 distances = BoundaryDistances(worldPos);
	float2 outsideDistances = max(distances, 0.0);
	if (outsideDistances.x > 0.0 && outsideDistances.y > 0.0)
	{
		return normalize(EllipseBoundaryNormal(worldPos) * outsideDistances.x + float2(0.0, -1.0) * outsideDistances.y);
	}
	return AnalyticBoundaryNormal(worldPos);
}

float2 AnalyticSurfaceNormal(float2 uv, float2 rayDir, float expansion)
{
	float2 worldNormal = OffsetBoundaryNormal(UvToWorld(uv), expansion);
	float2 normal = normalize(worldNormal / max(causticsWorldSize, 0.0001));
	return dot(rayDir, normal) > 0.0 ? -normal : normal;
}

float2 Refract2D(float2 rayDir, float2 normal, float eta)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	float cosI = dot(-rayDir, normal);
	float sinT2 = eta * eta * max(0.0, 1.0 - cosI * cosI);
	if (sinT2 > 1.0)
	{
		return normalize(rayDir - 2.0 * dot(rayDir, normal) * normal);
	}

	float cosT = sqrt(max(0.0, 1.0 - sinT2));
	return normalize(eta * rayDir + (eta * cosI - cosT) * normal);
}

bool CanRefract2D(float2 rayDir, float2 normal, float eta)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	float cosI = dot(-rayDir, normal);
	float sinT2 = eta * eta * max(0.0, 1.0 - cosI * cosI);
	return sinT2 <= 1.0;
}

float FresnelSchlick2D(float2 rayDir, float2 normal, float eta)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	if (!CanRefract2D(rayDir, normal, eta))
	{
		return 1.0;
	}

	float cosI = saturate(dot(-rayDir, normal));
	float r0 = (1.0 - eta) / (1.0 + eta);
	r0 *= r0;
	return saturate(r0 + (1.0 - r0) * pow(1.0 - cosI, 5.0));
}

float PhaseReflectance(int phase)
{
	return saturate(phase == 0 ? causticsPhase0Reflectance : causticsPhase1Reflectance);
}

float PhaseMetallic(int phase)
{
	return saturate(phase == 0 ? causticsPhase0Metallic : causticsPhase1Metallic);
}

float SurfaceReflectance(float2 rayDir, float2 normal, float eta, float materialReflectance)
{
	float fresnel = FresnelSchlick2D(rayDir, normal, eta) * max(causticsFresnelStrength, 0.0);
	return saturate(max(saturate(materialReflectance), fresnel));
}

float SurfaceTransmission(float2 rayDir, float2 normal, float eta, float materialReflectance)
{
	return saturate(1.0 - SurfaceReflectance(rayDir, normal, eta, materialReflectance));
}

float2 Reflect2D(float2 rayDir, float2 normal)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	return normalize(rayDir - 2.0 * dot(rayDir, normal) * normal);
}

uint HashUint(uint x)
{
	x ^= x >> 16;
	x *= 0x7feb352du;
	x ^= x >> 15;
	x *= 0x846ca68bu;
	x ^= x >> 16;
	return x;
}

float Hash01(uint seed)
{
	return ((HashUint(seed) & 0x00ffffffu) + 0.5) / 16777216.0;
}

float Random01(int raySeed, int stepIndex)
{
	uint seed = (uint)raySeed * 73856093u ^ (uint)stepIndex * 19349663u ^ (uint)causticsFrameIndex * 83492791u;
	return Hash01(seed);
}

float2 RandomUnitVector(uint seed)
{
	float angle = Hash01(seed) * 6.28318530718;
	return float2(cos(angle), sin(angle));
}

float3 VisibleWavelengthToRgb(float wavelengthNm)
{
	float w = wavelengthNm;
	float3 rgb = 0.0;

	if (w < 440.0)
	{
		rgb = float3((440.0 - w) / 60.0, 0.0, 1.0);
	}
	else if (w < 490.0)
	{
		rgb = float3(0.0, (w - 440.0) / 50.0, 1.0);
	}
	else if (w < 510.0)
	{
		rgb = float3(0.0, 1.0, (510.0 - w) / 20.0);
	}
	else if (w < 580.0)
	{
		rgb = float3((w - 510.0) / 70.0, 1.0, 0.0);
	}
	else if (w < 645.0)
	{
		rgb = float3(1.0, (645.0 - w) / 65.0, 0.0);
	}
	else
	{
		rgb = float3(1.0, 0.0, 0.0);
	}

	float edgeAttenuation = 1.0;
	if (w < 420.0)
	{
		edgeAttenuation = 0.3 + 0.7 * (w - 380.0) / 40.0;
	}
	else if (w > 620.0)
	{
		edgeAttenuation = 0.3 + 0.7 * (700.0 - w) / 80.0;
	}

	return saturate(rgb) * saturate(edgeAttenuation);
}

float SpectralWavelength(uint raySeed)
{
	return lerp(380.0, 700.0, Hash01(raySeed));
}

float SpectralOffsetFromWavelength(float wavelengthNm)
{
	return saturate((700.0 - wavelengthNm) / 300.0) * 2.0 - 1.0;
}

void InitSpectralRay(uint spectralSeed, uint spectralRotationSeed, int subRay, int raysPerPixel, out float spectralOffset, out float3 spectralMask)
{
	if (causticsDispersionStrength <= 0.0)
	{
		spectralOffset = 0.0;
		spectralMask = 1.0;
		return;
	}

	if (raysPerPixel >= 3)
	{
		float spectralRotation = Hash01(spectralRotationSeed) * saturate(causticsDispersionRotation);
		float t = frac(((float)subRay + 0.5) / max((float)raysPerPixel, 1.0) + spectralRotation);
		float wavelength = lerp(380.0, 700.0, t);
		spectralOffset = SpectralOffsetFromWavelength(wavelength);
		spectralMask = VisibleWavelengthToRgb(wavelength) * 3.0;
		return;
	}

	float wavelength = SpectralWavelength(spectralSeed);
	spectralOffset = SpectralOffsetFromWavelength(wavelength);
	spectralMask = VisibleWavelengthToRgb(wavelength) * 3.0;
}

float DispersedIor(float ior, float spectralOffset)
{
	float opticalDensity = max(ior, 1.0001) - 1.0;
	return max(1.0001, 1.0 + opticalDensity * (1.0 + spectralOffset * max(causticsDispersionStrength, 0.0)));
}

float2 Rotate2D(float2 v, float angle)
{
	float s = sin(angle);
	float c = cos(angle);
	return float2(v.x * c - v.y * s, v.x * s + v.y * c);
}

float2 SurfaceInteractionNormal(float2 uv, float2 rayDir, float2 baseNormal, int raySeed, int stepIndex, int subRay)
{
	float radius = max(causticsSurfaceNormalJitterPixels, 0.0);
	if (radius <= 0.0)
	{
		return baseNormal;
	}

	uint seed = (uint)raySeed * 73856093u ^ (uint)stepIndex * 19349663u ^ (uint)subRay * 83492791u ^ (uint)causticsFrameIndex * 2654435761u;
	float2 offsetPixels = RandomUnitVector(seed) * radius * sqrt(Hash01(seed ^ 0x9e3779b9u));
	float2 offsetUv = offsetPixels / float2(max(combinedWidth, 1), max(combinedHeight, 1));
	float2 sampledNormal = SurfaceNormal(uv + offsetUv, rayDir);
	return dot(sampledNormal, baseNormal) < 0.0 ? -sampledNormal : sampledNormal;
}

bool ResolveSurfaceDirection(inout float2 rayDir, inout float3 rayEnergy, float2 normal, float2 uv, float eta, float materialReflectance, float materialMetallic, float3 materialColour, int raySeed, int stepIndex, int subRay)
{
	if (causticsStochasticReflection != 0)
	{
		float reflectance = SurfaceReflectance(rayDir, normal, eta, materialReflectance);
		if (Random01(raySeed, stepIndex) < reflectance)
		{
			rayDir = Reflect2D(rayDir, SurfaceInteractionNormal(uv, rayDir, normal, raySeed, stepIndex, subRay));
			rayEnergy *= lerp(float3(1.0, 1.0, 1.0), max(materialColour, 0.0), saturate(materialMetallic));
			return false;
		}

		rayDir = Refract2D(rayDir, SurfaceInteractionNormal(uv, rayDir, normal, raySeed, stepIndex, subRay), eta);
		return true;
	}

	rayDir = Refract2D(rayDir, SurfaceInteractionNormal(uv, rayDir, normal, raySeed, stepIndex, subRay), eta);
	return true;
}

float2 FrameJitter2D(int frameIndex)
{
	float frame = (float)max(frameIndex, 0);
	return frac(0.5 + frame * float2(0.754877666, 0.569840291)) - 0.5;
}

float EffectiveAbsoluteIor(float ior, float spectralOffset)
{
	return max(1.0001, DispersedIor(ior, spectralOffset));
}

float PhaseIor(int phase, float spectralOffset)
{
	float ior = phase == 0 ? causticsPhase0IndexOfRefraction : causticsPhase1IndexOfRefraction;
	return DispersedIor(ior, spectralOffset);
}

float EffectivePhaseEta(bool enteringSelectedPhase, float spectralOffset)
{
	int selectedPhase = causticsPhase == 0 ? 0 : 1;
	int otherPhase = selectedPhase == 0 ? 1 : 0;
	float nSelected = PhaseIor(selectedPhase, spectralOffset);
	float nOther = PhaseIor(otherPhase, spectralOffset);
	float eta = enteringSelectedPhase ? nOther / nSelected : nSelected / nOther;
	return max(0.0001, eta);
}

bool InitializeRay(uint3 id, out float2 uv, out float2 rayDir)
{
	int2 rayId = int2(id.xy);
	float2 lightXY = float2(-causticsLightDirection.x, -causticsLightDirection.y);
	rayDir = length(lightXY) > 0.0001 ? normalize(lightXY) : float2(1.0, 0.0);
	uint initialRaySeed = (uint)rayId.x * 1973u ^ (uint)rayId.y * 9277u ^ (uint)causticsFrameIndex * 26699u;
	float angleJitter = (Hash01(initialRaySeed) * 2.0 - 1.0) * max(causticsLightAngularRadius, 0.0);
	rayDir = Rotate2D(rayDir, angleJitter);

	int rayStride = max(causticsRayStride, 1);
	int raysPerPixel = max(causticsRaysPerPixel, 1);
	int baseRay = rayId.x / raysPerPixel;
	int subRay = rayId.x - baseRay * raysPerPixel;
	if (rayId.y != 0 || baseRay >= causticsRayCount || baseRay % rayStride != 0)
	{
		return false;
	}

	float2 causticSize = float2(max(causticWidth, 1), max(causticHeight, 1));
	float2 tangent = float2(-rayDir.y, rayDir.x);
	float halfSpan = length(causticSize) * 0.5 + causticsStepPixels * 2.0;
	float2 temporalJitter = FrameJitter2D(causticsFrameIndex) * causticsTemporalJitterPixels;
	float rayOffset = (subRay + 0.5) / raysPerPixel;
	float spacing = max(causticsRaySpacing, 0.0001);
	float centreOffset = causticsRayStartOffset + (baseRay + rayOffset) * spacing + temporalJitter.x;
	float2 startPixel = causticSize * 0.5 - rayDir * halfSpan + tangent * centreOffset + rayDir * temporalJitter.y;
	uv = startPixel / causticSize;
	return true;
}

uint4 EncodeEnergy(float3 energy)
{
	uint3 rgb = (uint3)round(max(energy, 0.0) * 65535.0);
	return uint4(rgb.r, rgb.g, rgb.b, 0u);
}

void AddCausticAtUv(float2 uv, float energy, float3 colour)
{
	if (energy <= 0.0 || !InsideTexture(uv))
	{
		return;
	}

	float2 splatCentre = uv * float2(causticWidth - 1, causticHeight - 1);
	int2 splatPixel = (int2)round(splatCentre);
	uint4 encodedEnergy = EncodeEnergy(colour * energy);
	uint splatIndex = AccumIndex(splatPixel);
	InterlockedAdd(CausticAccum[splatIndex + 0], encodedEnergy.r);
	InterlockedAdd(CausticAccum[splatIndex + 1], encodedEnergy.g);
	InterlockedAdd(CausticAccum[splatIndex + 2], encodedEnergy.b);
}

void AddCausticMotionAtUv(float2 uv, float energy, float2 motionUv)
{
	if (energy <= 0.0 || !InsideTexture(uv))
	{
		return;
	}

	float weight = max(energy, 0.0);
	if (weight <= 0.0)
	{
		return;
	}

	float2 splatCentre = uv * float2(causticWidth - 1, causticHeight - 1);
	int2 splatPixel = (int2)round(splatCentre);
	uint splatIndex = AccumIndex(splatPixel);
	int encodedWeight = (int)round(weight * CausticMotionWeightScale);
	if (encodedWeight <= 0)
	{
		return;
	}

	float2 encodedMotionFloat = clamp(motionUv * weight * CausticMotionValueScale, -2147483000.0, 2147483000.0);
	int2 encodedMotion = (int2)round(encodedMotionFloat);
	InterlockedAdd(CausticMotionAccum[splatIndex + 0], encodedMotion.x);
	InterlockedAdd(CausticMotionAccum[splatIndex + 1], encodedMotion.y);
	InterlockedAdd(CausticMotionAccum[splatIndex + 2], encodedWeight);
}

void AddLightDirectionAtUv(float2 uv, float energy, float3 colour, float2 rayDir)
{
	if (energy <= 0.0 || causticsDirectionalLightFieldEnabled == 0 || !InsideTexture(uv))
	{
		return;
	}

	float luminance = dot(max(colour, 0.0), float3(0.2126, 0.7152, 0.0722));
	float directionWeight = max(energy * luminance, 0.0);
	if (directionWeight <= 0.0)
	{
		return;
	}

	float2 encodedDirection = saturate(normalize(rayDir) * 0.5 + 0.5);
	uint encodedWeight = (uint)round(directionWeight * 65535.0);
	uint2 encodedDirectionWeight = (uint2)round(encodedDirection * directionWeight * 65535.0);
	float2 splatCentre = uv * float2(causticWidth - 1, causticHeight - 1);
	int2 splatPixel = (int2)round(splatCentre);
	uint splatIndex = AccumIndex(splatPixel);
	InterlockedAdd(LightDirectionAccum[splatIndex + 0], encodedDirectionWeight.x);
	InterlockedAdd(LightDirectionAccum[splatIndex + 1], encodedDirectionWeight.y);
	InterlockedAdd(LightDirectionAccum[splatIndex + 2], encodedWeight);
}

[numthreads(16, 16, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= causticWidth || id.y >= causticHeight)
	{
		return;
	}

	uint index = AccumIndex(int2(id.xy));
	CausticAccum[index + 0] = 0;
	CausticAccum[index + 1] = 0;
	CausticAccum[index + 2] = 0;
	CausticAccum[index + 3] = 0;
	CausticResult[int2(id.xy)] = 0.0;
	if (causticsMotionEnabled != 0)
	{
		CausticMotionAccum[index + 0] = 0;
		CausticMotionAccum[index + 1] = 0;
		CausticMotionAccum[index + 2] = 0;
		CausticMotionAccum[index + 3] = 0;
		CausticMotionResult[int2(id.xy)] = 0.0;
	}
	if (causticsDirectionalLightFieldEnabled != 0)
	{
		LightDirectionAccum[index + 0] = 0;
		LightDirectionAccum[index + 1] = 0;
		LightDirectionAccum[index + 2] = 0;
		LightDirectionAccum[index + 3] = 0;
		LightDirectionResult[int2(id.xy)] = 0.0;
	}
}

[numthreads(64, 1, 1)]
void Trace(uint3 id : SV_DispatchThreadID)
{
	float2 uv;
	float2 rayDir;
	if (!InitializeRay(id, uv, rayDir))
	{
		return;
	}

	float2 causticSize = float2(causticWidth, causticHeight);
	float2 rayStep = rayDir * causticsStepPixels / causticSize;
	float stepWorldDistance = length(rayStep * causticsWorldSize);
	float4 currentCombined = InsideTexture(uv) ? SampleCombined(uv) : float4(0.0, 0.0, 0.0, 0.0);
	float previousDensity = SelectedDensity(currentCombined);
	bool inside = previousDensity >= densityThreshold;
	bool insideOuterBoundary = InsideOuterAnalyticBoundary(uv);
	bool insideInnerBoundary = InsideInnerAnalyticBoundary(uv);
	bool previousInsideOuterBoundary = insideOuterBoundary;
	bool previousInsideInnerBoundary = insideInnerBoundary;
	bool enteredBoundary = useEllipticalBounds == 0 || insideOuterBoundary;
	bool enteredTexture = InsideTexture(uv);
	float causticLineEnergy = max(causticsRayBrightness, 0.0) / max(causticsRaysPerPixel, 1);
	uint spectralSeed = id.x * 73856093u ^ id.y * 19349663u ^ (uint)causticsFrameIndex * 83492791u;
	int raysPerPixel = max(causticsRaysPerPixel, 1);
	int baseRay = (int)(id.x / (uint)raysPerPixel);
	int subRay = (int)(id.x - (uint)(baseRay * raysPerPixel));
	uint spectralRotationSeed = (uint)baseRay * 2654435761u ^ (uint)causticsFrameIndex * 2246822519u;
	float spectralOffset;
	float3 rayEnergy;
	InitSpectralRay(spectralSeed, spectralRotationSeed, subRay, raysPerPixel, spectralOffset, rayEnergy);
	int currentPhase = MediumPhaseFromCombined(currentCombined, insideInnerBoundary);
	float3 mediumColour = AbsorptionColourFromCombined(currentCombined, currentPhase);
	float2 rayMotionUv = 0.0;
	bool hasRayMotion = false;
	int raySeed = (int)id.x + (int)id.y;
	bool rayIsRefractedOnly = true;
	float effectiveGlassIor = EffectiveAbsoluteIor(causticsGlassIndexOfRefraction, spectralOffset);
	float effectiveFluidIor = EffectiveAbsoluteIor(causticsPhase1IndexOfRefraction, spectralOffset);
	int maxSteps = min(4096, (int)ceil(length(causticSize) / max(causticsStepPixels, 0.25)) + causticsRaySteps);

	for (int stepIndex = 0; stepIndex < maxSteps; stepIndex++)
	{
		uv += rayStep;
		bool inTexture = InsideTexture(uv);
		if (!inTexture)
		{
			if (enteredTexture && !inside)
			{
				return;
			}

			previousDensity = 0.0;
			continue;
		}

		enteredTexture = true;
		currentCombined = SampleCombined(uv);
		float density = SelectedDensity(currentCombined);
		insideOuterBoundary = InsideOuterAnalyticBoundary(uv);
		insideInnerBoundary = InsideInnerAnalyticBoundary(uv);

		if (useEllipticalBounds != 0 && previousInsideOuterBoundary != insideOuterBoundary)
		{
			bool enteringBoundary = !previousInsideOuterBoundary && insideOuterBoundary;
			float eta = enteringBoundary ? 1.0 / effectiveGlassIor : effectiveGlassIor;
			float2 normal = enteringBoundary
				? AnalyticSurfaceNormal(uv, rayDir, max(analyticBoundaryExpansion, 0.0))
				: -AnalyticSurfaceNormal(uv, rayDir, max(analyticBoundaryExpansion, 0.0));
			rayIsRefractedOnly = rayIsRefractedOnly && CanRefract2D(rayDir, normal, eta);
			rayEnergy *= SurfaceTransmission(rayDir, normal, eta, causticsGlassReflectance);
			rayDir = Refract2D(rayDir, normal, eta);

			rayStep = rayDir * causticsStepPixels / causticSize;
			stepWorldDistance = length(rayStep * causticsWorldSize);
		}

		if (useEllipticalBounds != 0 && previousInsideInnerBoundary != insideInnerBoundary)
		{
			bool enteringFluid = !previousInsideInnerBoundary && insideInnerBoundary;
			float eta = enteringFluid ? effectiveGlassIor / effectiveFluidIor : effectiveFluidIor / effectiveGlassIor;
			float2 normal = enteringFluid
				? AnalyticSurfaceNormal(uv, rayDir, 0.0)
				: -AnalyticSurfaceNormal(uv, rayDir, 0.0);
			rayIsRefractedOnly = rayIsRefractedOnly && CanRefract2D(rayDir, normal, eta);
			rayEnergy *= SurfaceTransmission(rayDir, normal, eta, causticsGlassReflectance);
			rayDir = Refract2D(rayDir, normal, eta);

			rayStep = rayDir * causticsStepPixels / causticSize;
			stepWorldDistance = length(rayStep * causticsWorldSize);
		}

		if (insideOuterBoundary)
		{
			enteredBoundary = true;
		}

		if (useEllipticalBounds != 0 && !insideOuterBoundary)
		{
			previousDensity = 0.0;
			previousInsideOuterBoundary = insideOuterBoundary;
			previousInsideInnerBoundary = insideInnerBoundary;
			continue;
		}

		int phase = MediumPhaseFromCombined(currentCombined, insideInnerBoundary);
		bool phaseChanged = phase != currentPhase;
		if (phaseChanged)
		{
			currentPhase = phase;
			mediumColour = AbsorptionColourFromCombined(currentCombined, currentPhase);
		}
		float absorption = 0.0;
		if (insideInnerBoundary)
		{
			absorption = currentPhase == 0 ? causticsPhase0Absorption : causticsPhase1Absorption;
		}
		if (absorption > 0.0)
		{
			int colourStride = max(causticsColourSampleStride, 1);
			if (!phaseChanged && stepIndex % colourStride == 0)
			{
				float2 colourUv = uv + rayStep * (0.5 * (float)colourStride);
				float4 colourCombined = InsideTexture(colourUv) ? SampleCombined(colourUv) : currentCombined;
				mediumColour = AbsorptionColourFromCombined(colourCombined, currentPhase);
			}

			float3 transmissionColour = max(mediumColour, float3(0.001, 0.001, 0.001));
			float3 spectralAbsorption = -log(transmissionColour) * absorption + absorption * 0.1;
			rayEnergy *= exp(-spectralAbsorption * stepWorldDistance);
		}
		if (!inside && previousDensity < densityThreshold && density >= densityThreshold)
		{
			float2 normal = SurfaceNormal(uv, rayDir);
			float eta = EffectivePhaseEta(true, spectralOffset);
			int selectedPhase = causticsPhase == 0 ? 0 : 1;
			if (causticsMotionEnabled != 0)
			{
				float2 surfaceMotionUv = SamplePhaseVelocity(uv, selectedPhase) * max(causticsDeltaTime, 0.0) / max(causticsWorldSize, 0.0001);
				if (hasRayMotion)
				{
					rayMotionUv = lerp(rayMotionUv, surfaceMotionUv, 0.025);
				}
				else
				{
					rayMotionUv = surfaceMotionUv;
					hasRayMotion = true;
				}
			}
			float materialReflectance = PhaseReflectance(selectedPhase);
			float materialMetallic = PhaseMetallic(selectedPhase);
			float3 materialColour = materialMetallic > 0.0 ? RayColourFromCombined(currentCombined, selectedPhase) : float3(1.0, 1.0, 1.0);
			bool canTransmit = CanRefract2D(rayDir, normal, eta);
			float surfaceEnergy = causticsStochasticReflection != 0
				? 1.0
				: SurfaceTransmission(rayDir, normal, eta, materialReflectance);
			bool transmitted = ResolveSurfaceDirection(rayDir, rayEnergy, normal, uv, eta, materialReflectance, materialMetallic, materialColour, raySeed, stepIndex, subRay);
			rayIsRefractedOnly = rayIsRefractedOnly && transmitted && canTransmit;
			rayEnergy *= surfaceEnergy;
			rayStep = rayDir * causticsStepPixels / causticSize;
			stepWorldDistance = length(rayStep * causticsWorldSize);
			inside = transmitted;
			density = transmitted ? density : densityThreshold - 0.000001;
		}
		else if (inside && previousDensity >= densityThreshold && density < densityThreshold)
		{
			float2 normal = -SurfaceNormal(uv, rayDir);
			float eta = EffectivePhaseEta(false, spectralOffset);
			int selectedPhase = causticsPhase == 0 ? 0 : 1;
			int otherPhase = selectedPhase == 0 ? 1 : 0;
			float materialReflectance = PhaseReflectance(otherPhase);
			float materialMetallic = PhaseMetallic(otherPhase);
			float3 materialColour = materialMetallic > 0.0 ? RayColourFromCombined(currentCombined, otherPhase) : float3(1.0, 1.0, 1.0);
			bool canTransmit = CanRefract2D(rayDir, normal, eta);
			float surfaceEnergy = causticsStochasticReflection != 0
				? 1.0
				: SurfaceTransmission(rayDir, normal, eta, materialReflectance);
			bool transmitted = ResolveSurfaceDirection(rayDir, rayEnergy, normal, uv, eta, materialReflectance, materialMetallic, materialColour, raySeed, stepIndex, subRay);
			rayIsRefractedOnly = rayIsRefractedOnly && transmitted && canTransmit;
			rayEnergy *= surfaceEnergy;
			rayStep = rayDir * causticsStepPixels / causticSize;
			stepWorldDistance = length(rayStep * causticsWorldSize);
			inside = !transmitted;
			density = transmitted ? density : densityThreshold + 0.000001;
		}

		if (causticLineEnergy > 0.0 && (useEllipticalBounds == 0 || insideOuterBoundary))
		{
			AddCausticAtUv(uv, causticLineEnergy, rayEnergy);
			if (causticsMotionEnabled != 0 && rayIsRefractedOnly)
			{
				float motionLuminance = dot(max(rayEnergy, 0.0), float3(0.2126, 0.7152, 0.0722));
				float motionEnergyWeight = sqrt(saturate(motionLuminance));
				AddCausticMotionAtUv(uv, causticLineEnergy * motionEnergyWeight, rayMotionUv);
			}
			if (rayIsRefractedOnly)
			{
				AddLightDirectionAtUv(uv, causticLineEnergy, rayEnergy, rayDir);
			}
		}

		previousDensity = density;
		previousInsideOuterBoundary = insideOuterBoundary;
		previousInsideInnerBoundary = insideInnerBoundary;
	}
}

[numthreads(16, 16, 1)]
void Resolve(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= causticWidth || id.y >= causticHeight)
	{
		return;
	}

	int2 pixel = int2(id.xy);
	uint index = AccumIndex(pixel);
	float3 caustic = float3((float)CausticAccum[index + 0], (float)CausticAccum[index + 1], (float)CausticAccum[index + 2]) / 65535.0;
	CausticResult[int2(id.xy)] = float4(caustic, 1.0);
	if (causticsMotionEnabled != 0)
	{
		float motionWeight = (float)CausticMotionAccum[index + 2];
		float2 motionUv = motionWeight > 0.0
			? float2((float)CausticMotionAccum[index + 0], (float)CausticMotionAccum[index + 1]) / max(motionWeight, 1.0) * (CausticMotionWeightScale / CausticMotionValueScale)
			: 0.0;
		float motionConfidence = saturate(motionWeight / CausticMotionWeightScale);
		CausticMotionResult[int2(id.xy)] = float4(motionUv, motionConfidence, 1.0);
	}
	if (causticsDirectionalLightFieldEnabled != 0)
	{
		float weight = (float)LightDirectionAccum[index + 2];
		float2 encodedDirection = weight > 0.0
			? float2((float)LightDirectionAccum[index + 0], (float)LightDirectionAccum[index + 1]) / weight
			: float2(0.5, 0.5);
		float2 direction = encodedDirection * 2.0 - 1.0;
		float directionLength = length(direction);
		direction = directionLength > 0.0001 ? direction / directionLength : float2(0.0, 0.0);
		LightDirectionResult[int2(id.xy)] = float4(direction, directionLength > 0.0001 ? 1.0 : 0.0, 1.0);
	}
}
