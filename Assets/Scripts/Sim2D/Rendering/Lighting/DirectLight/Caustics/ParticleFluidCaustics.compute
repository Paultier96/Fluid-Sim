#pragma kernel Clear
#pragma kernel Trace
#pragma kernel Resolve

Texture2D<float4> MaterialTransportTex;
Texture2D<float4> VelocityTex0;
Texture2D<float4> VelocityTex1;
Texture2D<float4> ColourMap;
Texture2D<float4> ColourMap2;
RWStructuredBuffer<uint> CausticAccum;
RWStructuredBuffer<int> CausticMotionAccum;
StructuredBuffer<float4> CausticsLights;
StructuredBuffer<float4> CausticsMaterials;
RWTexture2D<float4> CausticResult;
RWTexture2D<float4> CausticMotionResult;

#include "../../Shared/ParticleFluidCommon.hlsl"
#include "../../Shared/ParticleFluidCombinedSamplingCompute.hlsl"
#include "../../Shared/ParticleFluidGradientSamplingCompute.hlsl"
static const float CausticMotionWeightScale = 1048576.0;
static const float CausticMotionValueScale = 1048576.0;

int2 combinedResolution;
int2 transportResolution;
int2 materialNormalResolution;
int2 causticSize;
int causticsRayCount;
int causticsPhase = 0;
int causticsRaySteps;
int causticsRayStride;
int causticsRaysPerPixel;
int causticsColourSampleStride;
int causticsMotionEnabled;
int causticsStochasticReflection;
int causticsFrameIndex;
float causticsDispersionStrength;
float causticsDispersionRotation;
float causticsAbsorptionAlbedoBrightnessInfluence;
float causticsAbsorptionAlbedoSaturationInfluence;
float causticsRayBrightness;
float causticsTemporalJitterPixels;
float causticsSurfaceNormalJitterPixels;
float causticsDeltaTime;
int useEllipticalBounds;
float2 ellipseBoundsCenter;
float2 ellipseBoundsSize;
float obstacleY;
float analyticBoundaryExpansion;
float2 causticsWorldCenter;
float2 causticsWorldSize;

#include "../../Shared/ParticleFluidAnalyticBoundary.hlsl"

static const int CausticsLightStride = 6;
static const int CausticsMaterialStride = 2;

float4 LoadCausticsLightField(int lightIndex, int fieldIndex)
{
	return CausticsLights[lightIndex * CausticsLightStride + fieldIndex];
}

float4 CausticsLightLaunchDirectionAndEnabled(int lightIndex) { return LoadCausticsLightField(lightIndex, 0); }
float4 CausticsLightMultiplierAndLaunchMode(int lightIndex) { return LoadCausticsLightField(lightIndex, 1); }
float4 CausticsLightLaunchAnchor(int lightIndex) { return LoadCausticsLightField(lightIndex, 2); }
float4 CausticsLightLaunchSpan(int lightIndex) { return LoadCausticsLightField(lightIndex, 3); }
float4 CausticsLightRayAllocation(int lightIndex) { return LoadCausticsLightField(lightIndex, 4); }
float4 CausticsLightExtra(int lightIndex) { return LoadCausticsLightField(lightIndex, 5); }

int CausticsLightEnabled(int lightIndex) { return (int)(CausticsLightLaunchDirectionAndEnabled(lightIndex).w + 0.5); }
int CausticsLightLaunchMode(int lightIndex) { return (int)(CausticsLightMultiplierAndLaunchMode(lightIndex).w + 0.5); }
float3 CausticsLightLaunchDirection(int lightIndex) { return CausticsLightLaunchDirectionAndEnabled(lightIndex).xyz; }
float3 CausticsLightMultiplier(int lightIndex) { return max(CausticsLightMultiplierAndLaunchMode(lightIndex).xyz, 0.0); }
float CausticsLightLaunchFalloff(int lightIndex) { return CausticsLightLaunchSpan(lightIndex).x; }
float CausticsLightAngularRadius(int lightIndex) { return CausticsLightLaunchSpan(lightIndex).y; }
float CausticsLightLaunchSpanStart(int lightIndex) { return CausticsLightLaunchSpan(lightIndex).z; }
float CausticsLightLaunchSpanLength(int lightIndex) { return CausticsLightLaunchSpan(lightIndex).w; }
int CausticsLightAllocatedRayCount(int lightIndex) { return (int)(CausticsLightRayAllocation(lightIndex).x + 0.5); }
int CausticsLightSubRaysPerPixel(int lightIndex) { return (int)(CausticsLightRayAllocation(lightIndex).y + 0.5); }
float CausticsLightLaunchOffset(int lightIndex) { return CausticsLightRayAllocation(lightIndex).z; }
float CausticsLightLaunchSpacing(int lightIndex) { return CausticsLightRayAllocation(lightIndex).w; }
float CausticsLightTemperatureKelvin(int lightIndex) { return CausticsLightExtra(lightIndex).x; }
float CausticsLightDispersionScale(int lightIndex) { return CausticsLightExtra(lightIndex).y; }

float4 LoadCausticsMaterialField(int materialIndex, int fieldIndex)
{
	return CausticsMaterials[materialIndex * CausticsMaterialStride + fieldIndex];
}

float4 CausticsMaterialSurface(int materialIndex) { return LoadCausticsMaterialField(materialIndex, 0); }
float4 CausticsMaterialTint(int materialIndex) { return LoadCausticsMaterialField(materialIndex, 1); }
float CausticsMaterialIor(int materialIndex) { return CausticsMaterialSurface(materialIndex).x; }
float CausticsMaterialReflectance(int materialIndex) { return CausticsMaterialSurface(materialIndex).y; }
float CausticsMaterialMetallic(int materialIndex) { return CausticsMaterialSurface(materialIndex).z; }
float CausticsMaterialAbsorption(int materialIndex) { return CausticsMaterialSurface(materialIndex).w; }
float3 CausticsMaterialAbsorptionTint(int materialIndex) { return max(CausticsMaterialTint(materialIndex).rgb, 0.0); }
float CausticsMaterialAbsorptionTintBlend(int materialIndex) { return CausticsMaterialTint(materialIndex).a; }

float4 SampleTransport(float2 uv)
{
	int2 pixel = (int2)round(saturate(uv) * (transportResolution - 1));
	return MaterialTransportTex.Load(int3(clamp(pixel, int2(0, 0), transportResolution - 1), 0));
}

int2 VelocityPixel(float2 uv)
{
	int2 pixel = (int2)round(saturate(uv) * (transportResolution - 1));
	return clamp(pixel, int2(0, 0), transportResolution - 1);
}

uint AccumIndex(int2 pixel)
{
	return (uint)((pixel.y * causticSize.x + pixel.x) * 4);
}

float SelectedDensity(float4 transport)
{
	float support = transport.b;
	float phaseT = transport.a;
	float selectedPhaseWeight = causticsPhase == 0 ? (1.0 - phaseT) : phaseT;
	return support * selectedPhaseWeight;
}

float DensityAt(float2 uv)
{
	if (!ParticleFluidInsideUv01(uv))
	{
		return 0.0;
	}

	return SelectedDensity(SampleTransport(uv));
}

int PhaseFromTransport(float4 transport)
{
	if (transport.b <= 0.5)
	{
		return -1;
	}

	return transport.a < 0.5 ? 0 : 1;
}

float4 LoadPhaseVelocityPacked(int2 pixel, int phase)
{
	pixel = clamp(pixel, int2(0, 0), int2(transportResolution.x - 1, transportResolution.y - 1));
	return phase == 0
		? VelocityTex0.Load(int3(pixel, 0))
		: VelocityTex1.Load(int3(pixel, 0));
}

float4 SamplePhaseVelocityPackedNeighborhood(int2 pixel, int phase, int radius)
{
	float4 packedVelocity = 0.0;
	[loop]
	for (int y = -radius; y <= radius; y++)
	{
		[loop]
		for (int x = -radius; x <= radius; x++)
		{
			int distance = abs(x) + abs(y);
			float sampleWeight = 1.0 / (1.0 + (float)distance);
			packedVelocity += LoadPhaseVelocityPacked(pixel + int2(x, y), phase) * sampleWeight;
		}
	}

	return packedVelocity;
}

float2 SamplePhaseVelocity(float2 uv, int phase)
{
	int2 pixel = VelocityPixel(uv);
	float4 packedVelocity = SamplePhaseVelocityPackedNeighborhood(pixel, phase, 1);
	if (packedVelocity.b <= 0.0001)
	{
		packedVelocity = SamplePhaseVelocityPackedNeighborhood(pixel, phase, 3);
	}

	if (packedVelocity.b <= 0.0001)
	{
		return 0.0;
	}

	return packedVelocity.rg / packedVelocity.b;
}

int PhaseAt(float2 uv)
{
	return ParticleFluidInsideUv01(uv) ? PhaseFromTransport(SampleTransport(uv)) : -1;
}

float PhaseScalarData(float4 transport, int phase)
{
	return phase == 0 ? transport.r : transport.g;
}

float3 RayColourFromTransport(float4 transport, int phase)
{
	float scalarData = PhaseScalarData(transport, phase);
	return phase == 0
		? ParticleFluidSampleColourMap(ColourMap, scalarData)
		: ParticleFluidSampleColourMap(ColourMap2, scalarData);
}

float3 AbsorptionColourFromTransport(float4 transport, int phase)
{
	float3 albedoColour = RayColourFromTransport(transport, phase);
	float maxChannel = max(max(albedoColour.r, albedoColour.g), albedoColour.b);
	float3 hueColour = maxChannel > 0.0001 ? albedoColour / maxChannel : float3(1.0, 1.0, 1.0);
	if (phase == 0)
	{
		float brightness = lerp(1.0, maxChannel, saturate(causticsAbsorptionAlbedoBrightnessInfluence));
		float luminance = dot(hueColour, float3(0.2126, 0.7152, 0.0722));
		float3 controlledHue = lerp(float3(luminance, luminance, luminance), hueColour, saturate(causticsAbsorptionAlbedoSaturationInfluence));
		float3 brightnessControlledAlbedo = controlledHue * brightness;
		return lerp(brightnessControlledAlbedo, CausticsMaterialAbsorptionTint(0), saturate(CausticsMaterialAbsorptionTintBlend(0)));
	}
	if (phase == 1)
	{
		float brightness = lerp(1.0, maxChannel, saturate(causticsAbsorptionAlbedoBrightnessInfluence));
		float luminance = dot(hueColour, float3(0.2126, 0.7152, 0.0722));
		float3 controlledHue = lerp(float3(luminance, luminance, luminance), hueColour, saturate(causticsAbsorptionAlbedoSaturationInfluence));
		float3 brightnessControlledAlbedo = controlledHue * brightness;
		return lerp(brightnessControlledAlbedo, CausticsMaterialAbsorptionTint(1), saturate(CausticsMaterialAbsorptionTintBlend(1)));
	}

	return albedoColour;
}

float3 RayColourAt(float2 uv)
{
	if (!ParticleFluidInsideUv01(uv))
	{
		return 1.0;
	}

	float4 transport = SampleTransport(uv);
	return RayColourFromTransport(transport, PhaseFromTransport(transport));
}

float2 SurfaceNormal(float2 uv, float2 rayDir)
{
	float2 texel = 1.0 / float2(max(transportResolution.x, 1),max(transportResolution.y, 1));
	float dx = DensityAt(uv + float2(texel.x, 0.0)) - DensityAt(uv - float2(texel.x, 0.0));
	float dy = DensityAt(uv + float2(0.0, texel.y)) - DensityAt(uv - float2(0.0, texel.y));
	
	float2 gradient = float2(dx, dy);
	float2 normal = length(gradient) > 0.000001 ? -normalize(gradient) : 0.0;
	

	if (length(normal) <= 0.000001)
	{
		normal = -normalize(rayDir + 0.0001);
	}

	return dot(rayDir, normal) > 0.0 ? -normal : normal;
}

float2 UvToWorld(float2 uv)
{
	return ParticleFluidWorldFromUv(uv, causticsWorldCenter, causticsWorldSize);
}

float2 WorldToUv(float2 worldPos)
{
	return ParticleFluidUvFromWorld(worldPos, causticsWorldCenter, causticsWorldSize);
}

float PointLightAttenuation(float2 worldPos, float4 pointLight, float falloff)
{
	float range = max(pointLight.w, 0.0001);
	float distanceToLight = length(worldPos - pointLight.xy);
	return pow(saturate(1.0 - distanceToLight / range), max(falloff, 0.1));
}

bool InsideOuterAnalyticBoundary(float2 uv)
{
	return useEllipticalBounds == 0 || OuterAnalyticBoundaryDistance(UvToWorld(uv)) <= 0.0;
}

bool InsideInnerAnalyticBoundary(float2 uv)
{
	return useEllipticalBounds == 0 || InnerAnalyticBoundaryDistance(UvToWorld(uv)) <= 0.0;
}

int MediumPhaseFromTransport(float4 transport, bool insideFluidBoundary)
{
	int phase = PhaseFromTransport(transport);
	return phase >= 0 || useEllipticalBounds == 0 || !insideFluidBoundary ? phase : 1;
}

float2 AnalyticSurfaceNormal(float2 uv, float2 rayDir, float expansion)
{
	float2 worldNormal = OffsetBoundaryNormal(UvToWorld(uv), expansion);
	float2 normal = normalize(worldNormal);
	return dot(rayDir, normal) > 0.0 ? -normal : normal;
}

float2 Refract2D(float2 rayDir, float2 normal, float eta)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	float cosI = dot(-rayDir, normal);
	float sinT2 = eta * eta * max(0.0, 1.0 - cosI * cosI);
	if (sinT2 > 1.0)
	{
		return normalize(rayDir - 2.0 * dot(rayDir, normal) * normal);
	}

	float cosT = sqrt(max(0.0, 1.0 - sinT2));
	return normalize(eta * rayDir + (eta * cosI - cosT) * normal);
}

bool CanRefract2D(float2 rayDir, float2 normal, float eta)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	float cosI = dot(-rayDir, normal);
	float sinT2 = eta * eta * max(0.0, 1.0 - cosI * cosI);
	return sinT2 <= 1.0;
}

float FresnelSchlick2D(float2 rayDir, float2 normal, float eta)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	if (!CanRefract2D(rayDir, normal, eta))
	{
		return 1.0;
	}

	float cosI = saturate(dot(-rayDir, normal));
	float r0 = (1.0 - eta) / (1.0 + eta);
	r0 *= r0;
	return saturate(r0 + (1.0 - r0) * pow(1.0 - cosI, 5.0));
}

float PhaseReflectance(int phase)
{
	return saturate(CausticsMaterialReflectance(phase));
}

float PhaseMetallic(int phase)
{
	return saturate(CausticsMaterialMetallic(phase));
}

float SurfaceReflectance(float2 rayDir, float2 normal, float eta, float materialReflectance)
{
	float fresnel = FresnelSchlick2D(rayDir, normal, eta);
	return saturate(max(saturate(materialReflectance), fresnel));
}

float SurfaceTransmission(float2 rayDir, float2 normal, float eta, float materialReflectance)
{
	return saturate(1.0 - SurfaceReflectance(rayDir, normal, eta, materialReflectance));
}

float2 Reflect2D(float2 rayDir, float2 normal)
{
	normal = dot(rayDir, normal) > 0.0 ? -normal : normal;
	return normalize(rayDir - 2.0 * dot(rayDir, normal) * normal);
}

uint HashUint(uint x)
{
	x ^= x >> 16;
	x *= 0x7feb352du;
	x ^= x >> 15;
	x *= 0x846ca68bu;
	x ^= x >> 16;
	return x;
}

float Hash01(uint seed)
{
	return ((HashUint(seed) & 0x00ffffffu) + 0.5) / 16777216.0;
}

float Random01(int raySeed, int stepIndex)
{
	uint seed = (uint)raySeed * 73856093u ^ (uint)stepIndex * 19349663u ^ (uint)causticsFrameIndex * 83492791u;
	return Hash01(seed);
}

float2 RandomUnitVector(uint seed)
{
	float angle = Hash01(seed) * 6.28318530718;
	return float2(cos(angle), sin(angle));
}

float3 VisibleWavelengthToRgb(float wavelengthNm)
{
	float w = wavelengthNm;
	float3 rgb = 0.0;

	if (w < 440.0)
	{
		rgb = float3((440.0 - w) / 60.0, 0.0, 1.0);
	}
	else if (w < 490.0)
	{
		rgb = float3(0.0, (w - 440.0) / 50.0, 1.0);
	}
	else if (w < 510.0)
	{
		rgb = float3(0.0, 1.0, (510.0 - w) / 20.0);
	}
	else if (w < 580.0)
	{
		rgb = float3((w - 510.0) / 70.0, 1.0, 0.0);
	}
	else if (w < 645.0)
	{
		rgb = float3(1.0, (645.0 - w) / 65.0, 0.0);
	}
	else
	{
		rgb = float3(1.0, 0.0, 0.0);
	}

	float edgeAttenuation = 1.0;
	if (w < 420.0)
	{
		edgeAttenuation = 0.3 + 0.7 * (w - 380.0) / 40.0;
	}
	else if (w > 620.0)
	{
		edgeAttenuation = 0.3 + 0.7 * (700.0 - w) / 80.0;
	}

	return saturate(rgb) * saturate(edgeAttenuation);
}

float BlackbodySpectralWeight(float wavelengthNm, float temperatureKelvin)
{
	float wavelength = max(wavelengthNm, 1.0);
	float temperature = clamp(temperatureKelvin, 1000.0, 20000.0);
	float exponent = clamp(14387769.0 / (wavelength * temperature), 0.0001, 80.0);
	float wavelengthRatio = 560.0 / wavelength;
	return pow(wavelengthRatio, 5.0) / max(exp(exponent) - 1.0, 0.000001);
}

float SpectralWeight(float wavelengthNm, float temperatureKelvin)
{
	return max(BlackbodySpectralWeight(wavelengthNm, temperatureKelvin), 0.000001);
}

float LightWeightedSpectralWavelength(float t, float temperatureKelvin)
{
	float totalWeight = 0.0;
	[unroll]
	for (int i = 0; i < 16; i++)
	{
		float wavelength = lerp(380.0, 700.0, ((float)i + 0.5) / 16.0);
		totalWeight += SpectralWeight(wavelength, temperatureKelvin);
	}

	float targetWeight = saturate(t) * totalWeight;
	float accumulatedWeight = 0.0;
	[unroll]
	for (int i = 0; i < 16; i++)
	{
		float segmentStart = (float)i / 16.0;
		float segmentEnd = ((float)i + 1.0) / 16.0;
		float wavelength = lerp(380.0, 700.0, (segmentStart + segmentEnd) * 0.5);
		float segmentWeight = SpectralWeight(wavelength, temperatureKelvin);
		if (targetWeight <= accumulatedWeight + segmentWeight)
		{
			float localT = (targetWeight - accumulatedWeight) / max(segmentWeight, 0.000001);
			return lerp(380.0, 700.0, lerp(segmentStart, segmentEnd, saturate(localT)));
		}

		accumulatedWeight += segmentWeight;
	}

	return 700.0;
}

float3 ExpectedSpectralColour(float3 lightColour, float temperatureKelvin)
{
	float3 expectedColour = 0.0;
	float totalWeight = 0.0;
	[unroll]
	for (int i = 0; i < 16; i++)
	{
		float wavelength = lerp(380.0, 700.0, ((float)i + 0.5) / 16.0);
		float3 filteredSpectrum = VisibleWavelengthToRgb(wavelength) * max(lightColour, 0.0);
		float weight = SpectralWeight(wavelength, temperatureKelvin);
		expectedColour += filteredSpectrum * weight;
		totalWeight += weight;
	}

	return expectedColour / max(totalWeight, 0.000001);
}

float3 BalanceSpectralEnergy(float3 energy, float3 lightColour, float temperatureKelvin)
{
	float3 targetColour = max(lightColour, 0.0);
	float3 expectedColour = max(ExpectedSpectralColour(targetColour, temperatureKelvin), 0.000001);
	return energy * targetColour / expectedColour;
}

float SpectralOffsetFromWavelength(float wavelengthNm)
{
	return saturate((700.0 - wavelengthNm) / 300.0) * 2.0 - 1.0;
}

void InitSpectralRay(uint spectralSeed, uint spectralRotationSeed, int subRay, int raysPerPixel, float3 lightColour, float temperatureKelvin, float dispersionScale, out float spectralOffset, out float3 spectralMask)
{
	dispersionScale = saturate(dispersionScale);
	if (causticsDispersionStrength <= 0.0 || dispersionScale <= 0.0001)
	{
		spectralOffset = 0.0;
		spectralMask = max(lightColour, 0.0);
		return;
	}

	float wavelengthT;
	if (raysPerPixel >= 3)
	{
		float spectralRotation = Hash01(spectralRotationSeed) * saturate(causticsDispersionRotation);
		wavelengthT = frac(((float)subRay + 0.5) / max((float)raysPerPixel, 1.0) + spectralRotation);
	}
	else
	{
		wavelengthT = Hash01(spectralSeed);
	}

	float wavelength = LightWeightedSpectralWavelength(wavelengthT, temperatureKelvin);
	spectralOffset = SpectralOffsetFromWavelength(wavelength) * dispersionScale;
	float3 filteredSpectrum = VisibleWavelengthToRgb(wavelength) * max(lightColour, 0.0);
	spectralMask = lerp(max(lightColour, 0.0), BalanceSpectralEnergy(filteredSpectrum, lightColour, temperatureKelvin), dispersionScale);
}

float DispersedIor(float ior, float spectralOffset)
{
	float opticalDensity = max(ior, 1.0001) - 1.0;
	return max(1.0001, 1.0 + opticalDensity * (1.0 + spectralOffset * max(causticsDispersionStrength, 0.0)));
}

float2 Rotate2D(float2 v, float angle)
{
	float s = sin(angle);
	float c = cos(angle);
	return float2(v.x * c - v.y * s, v.x * s + v.y * c);
}

float2 SurfaceInteractionNormal(float2 uv, float2 rayDir, float2 baseNormal, int raySeed, int stepIndex, int subRay)
{
	float radius = max(causticsSurfaceNormalJitterPixels, 0.0);
	if (radius <= 0.0)
	{
		return baseNormal;
	}

	uint seed = (uint)raySeed * 73856093u ^ (uint)stepIndex * 19349663u ^ (uint)subRay * 83492791u ^ (uint)causticsFrameIndex * 2654435761u;
	float2 offsetPixels = RandomUnitVector(seed) * radius * sqrt(Hash01(seed ^ 0x9e3779b9u));
	float2 offsetUv = offsetPixels / float2(max(transportResolution.x, 1), max(transportResolution.y, 1));
	float2 sampledNormal = SurfaceNormal(uv + offsetUv, rayDir);
	return dot(sampledNormal, baseNormal) < 0.0 ? -sampledNormal : sampledNormal;
}

bool ResolveSurfaceDirection(inout float2 rayDir, inout float3 rayEnergy, float2 normal, float2 uv, float eta, float materialReflectance, float materialMetallic, float3 materialColour, int raySeed, int stepIndex, int subRay)
{
	if (causticsStochasticReflection != 0)
	{
		float reflectance = SurfaceReflectance(rayDir, normal, eta, materialReflectance);
		if (Random01(raySeed, stepIndex) < reflectance)
		{
			rayDir = Reflect2D(rayDir, SurfaceInteractionNormal(uv, rayDir, normal, raySeed, stepIndex, subRay));
			rayEnergy *= lerp(float3(1.0, 1.0, 1.0), max(materialColour, 0.0), saturate(materialMetallic));
			return false;
		}

		rayDir = Refract2D(rayDir, SurfaceInteractionNormal(uv, rayDir, normal, raySeed, stepIndex, subRay), eta);
		return true;
	}

	rayDir = Refract2D(rayDir, SurfaceInteractionNormal(uv, rayDir, normal, raySeed, stepIndex, subRay), eta);
	return true;
}

float2 FrameJitter2D(int frameIndex)
{
	float frame = (float)max(frameIndex, 0);
	return frac(0.5 + frame * float2(0.754877666, 0.569840291)) - 0.5;
}

float EffectiveAbsoluteIor(float ior, float spectralOffset)
{
	return max(1.0001, DispersedIor(ior, spectralOffset));
}

float PhaseIor(int phase, float spectralOffset)
{
	float ior = CausticsMaterialIor(phase);
	return DispersedIor(ior, spectralOffset);
}

float EffectivePhaseEta(bool enteringSelectedPhase, float spectralOffset)
{
	int selectedPhase = causticsPhase == 0 ? 0 : 1;
	int otherPhase = selectedPhase == 0 ? 1 : 0;
	float nSelected = PhaseIor(selectedPhase, spectralOffset);
	float nOther = PhaseIor(otherPhase, spectralOffset);
	float eta = enteringSelectedPhase ? nOther / nSelected : nSelected / nOther;
	return max(0.0001, eta);
}

bool InitializeRay(uint3 id, out float2 uv, out float2 rayDir, out float3 lightMultiplier, out float lightSampleWeight, out int lightSubRay, out int lightSubRayCount, out int pointLight, out float4 launchAnchor, out float launchFalloff, out float lightTemperatureKelvin, out float lightDispersionScale)
{
	int2 rayId = int2(id.xy);
	int raysPerPixel = max(causticsRaysPerPixel, 1);
	int baseRay = rayId.x / raysPerPixel;
	int subRay = rayId.x - baseRay * raysPerPixel;
	int primaryRayCount = max(CausticsLightAllocatedRayCount(0), 0);
	int secondaryRayCount = max(CausticsLightAllocatedRayCount(1), 0);
	int tertiaryRayCount = max(CausticsLightAllocatedRayCount(2), 0);
	int primarySubRaysPerPixel = clamp(CausticsLightSubRaysPerPixel(0), 0, raysPerPixel);
	int secondarySubRaysPerPixel = clamp(CausticsLightSubRaysPerPixel(1), 0, raysPerPixel - primarySubRaysPerPixel);
	int tertiarySubRaysPerPixel = clamp(CausticsLightSubRaysPerPixel(2), 0, raysPerPixel - primarySubRaysPerPixel - secondarySubRaysPerPixel);
	bool splitBySubRay = (CausticsLightEnabled(1) != 0 && secondarySubRaysPerPixel > 0) || (CausticsLightEnabled(2) != 0 && tertiarySubRaysPerPixel > 0);
	bool tertiaryRay = splitBySubRay
		? subRay >= primarySubRaysPerPixel + secondarySubRaysPerPixel
		: CausticsLightEnabled(2) != 0 && baseRay >= primaryRayCount + secondaryRayCount && baseRay < primaryRayCount + secondaryRayCount + tertiaryRayCount;
	bool secondaryRay = !tertiaryRay && (splitBySubRay
		? subRay >= primarySubRaysPerPixel && subRay < primarySubRaysPerPixel + secondarySubRaysPerPixel
		: CausticsLightEnabled(1) != 0 && baseRay >= primaryRayCount && baseRay < primaryRayCount + secondaryRayCount);
	int lightIndex = tertiaryRay ? 2 : secondaryRay ? 1 : 0;
	int localBaseRay = splitBySubRay
		? baseRay
		: tertiaryRay
			? baseRay - primaryRayCount - secondaryRayCount
			: secondaryRay
				? baseRay - primaryRayCount
				: baseRay;
	int localRayCount = tertiaryRay
		? (splitBySubRay ? causticsRayCount : tertiaryRayCount)
		: secondaryRay
		? (splitBySubRay ? causticsRayCount : secondaryRayCount)
		: primaryRayCount;
	int localSubRay = !splitBySubRay
		? subRay
		: tertiaryRay
			? subRay - primarySubRaysPerPixel - secondarySubRaysPerPixel
			: secondaryRay
				? subRay - primarySubRaysPerPixel
				: subRay;
	int localSubRayCount = !splitBySubRay
		? raysPerPixel
		: tertiaryRay
			? tertiarySubRaysPerPixel
			: secondaryRay
				? secondarySubRaysPerPixel
				: primarySubRaysPerPixel;
	lightSubRay = localSubRay;
	lightSubRayCount = max(localSubRayCount, 1);
	int launchMode = CausticsLightLaunchMode(lightIndex);
	lightTemperatureKelvin = CausticsLightTemperatureKelvin(lightIndex);
	lightDispersionScale = CausticsLightDispersionScale(lightIndex);
	float3 lightDirection = CausticsLightLaunchDirection(lightIndex);
	launchAnchor = CausticsLightLaunchAnchor(lightIndex);
	launchFalloff = CausticsLightLaunchFalloff(lightIndex);
	float lightAngularRadius = CausticsLightAngularRadius(lightIndex);
	float launchSpanStart = CausticsLightLaunchSpanStart(lightIndex);
	float launchSpanLength = CausticsLightLaunchSpanLength(lightIndex);
	float rayStartOffset = CausticsLightLaunchOffset(lightIndex);
	float raySpacing = CausticsLightLaunchSpacing(lightIndex);
	lightMultiplier = CausticsLightMultiplier(lightIndex);
	lightSampleWeight = splitBySubRay
		? (float)raysPerPixel / (float)lightSubRayCount
		: max(raySpacing, 0.0001);

	float2 lightXY = float2(-lightDirection.x, -lightDirection.y);
	rayDir = length(lightXY) > 0.0001 ? normalize(lightXY) : float2(1.0, 0.0);
	uint initialRaySeed = (uint)rayId.x * 1973u ^ (uint)rayId.y * 9277u ^ (uint)causticsFrameIndex * 26699u;
	float angleJitter = (Hash01(initialRaySeed) * 2.0 - 1.0) * max(lightAngularRadius, 0.0);
	rayDir = Rotate2D(rayDir, angleJitter);

	int rayStride = max(causticsRayStride, 1);
	if (rayId.y != 0 || baseRay >= causticsRayCount || localRayCount <= 0 || localSubRayCount <= 0 || localBaseRay >= localRayCount || localBaseRay % rayStride != 0)
	{
		return false;
	}
	
	float2 temporalJitter = FrameJitter2D(causticsFrameIndex) * causticsTemporalJitterPixels;
	float rayOffset = splitBySubRay ? (lightSubRay + 0.5) / lightSubRayCount : (subRay + 0.5) / raysPerPixel;
	pointLight = launchMode == 1 ? 1 : 0;
	if (pointLight != 0)
	{
		float angleRange = max(launchSpanLength, 0.0001);
		float angle = launchSpanStart + ((float)localBaseRay + rayOffset) / max((float)localRayCount, 1.0) * angleRange + temporalJitter.x * 0.01;
		rayDir = float2(cos(angle), sin(angle));
		rayDir = Rotate2D(rayDir, angleJitter);
		uv = WorldToUv(launchAnchor.xy) + rayDir * temporalJitter.y / causticSize;
		return true;
	}

	float2 tangent = float2(-rayDir.y, rayDir.x);
	float halfSpan = length(causticSize) * 0.5 + 2.0;
	float spacing = max(raySpacing, 0.0001);
	float centreOffset = rayStartOffset + (localBaseRay + rayOffset) * spacing + temporalJitter.x;
	float2 startPixel = causticSize * 0.5 - rayDir * halfSpan + tangent * centreOffset + rayDir * temporalJitter.y;
	uv = startPixel / causticSize;
	return true;
}

uint4 EncodeEnergy(float3 energy)
{
	uint3 rgb = (uint3)round(max(energy, 0.0) * 65535.0);
	return uint4(rgb.r, rgb.g, rgb.b, 0u);
}

void AddCausticAtUv(float2 uv, float energy, float3 colour)
{
	if (energy <= 0.0 || !ParticleFluidInsideUv01(uv))
	{
		return;
	}

	float2 splatCentre = uv * (causticSize-1);
	int2 splatPixel = (int2)round(splatCentre);
	uint4 encodedEnergy = EncodeEnergy(colour * energy);
	uint splatIndex = AccumIndex(splatPixel);
	InterlockedAdd(CausticAccum[splatIndex + 0], encodedEnergy.r);
	InterlockedAdd(CausticAccum[splatIndex + 1], encodedEnergy.g);
	InterlockedAdd(CausticAccum[splatIndex + 2], encodedEnergy.b);
}

void AddCausticMotionAtUv(float2 uv, float energy, float2 motionUv)
{
	if (energy <= 0.0 || !ParticleFluidInsideUv01(uv))
	{
		return;
	}

	float weight = max(energy, 0.0);
	if (weight <= 0.0)
	{
		return;
	}

	float2 splatCentre = uv * (causticSize - 1);
	int2 splatPixel = (int2)round(splatCentre);
	uint splatIndex = AccumIndex(splatPixel);
	int encodedWeight = (int)round(weight * CausticMotionWeightScale);
	if (encodedWeight <= 0)
	{
		return;
	}

	float2 encodedMotionFloat = clamp(motionUv * weight * CausticMotionValueScale, -2147483000.0, 2147483000.0);
	int2 encodedMotion = (int2)round(encodedMotionFloat);
	InterlockedAdd(CausticMotionAccum[splatIndex + 0], encodedMotion.x);
	InterlockedAdd(CausticMotionAccum[splatIndex + 1], encodedMotion.y);
	InterlockedAdd(CausticMotionAccum[splatIndex + 2], encodedWeight);
}

[numthreads(16, 16, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= causticSize.x || id.y >= causticSize.y)
	{
		return;
	}

	uint index = AccumIndex(int2(id.xy));
	CausticAccum[index + 0] = 0;
	CausticAccum[index + 1] = 0;
	CausticAccum[index + 2] = 0;
	CausticAccum[index + 3] = 0;
	CausticResult[int2(id.xy)] = 0.0;
	if (causticsMotionEnabled != 0)
	{
		CausticMotionAccum[index + 0] = 0;
		CausticMotionAccum[index + 1] = 0;
		CausticMotionAccum[index + 2] = 0;
		CausticMotionAccum[index + 3] = 0;
		CausticMotionResult[int2(id.xy)] = 0.0;
	}
}

[numthreads(64, 1, 1)]
void Trace(uint3 id : SV_DispatchThreadID)
{
	float2 uv;
	float2 rayDir;
	float3 lightMultiplier;
	float lightSampleWeight;
	int lightSubRay;
	int lightSubRayCount;
	int pointLight;
	float4 launchAnchor;
	float launchFalloff;
	float lightTemperatureKelvin;
	float lightDispersionScale;
	if (!InitializeRay(id, uv, rayDir, lightMultiplier, lightSampleWeight, lightSubRay, lightSubRayCount, pointLight, launchAnchor, launchFalloff, lightTemperatureKelvin, lightDispersionScale))
	{
		return;
	}

	float2 rayStep = rayDir / causticSize;
	float stepWorldDistance = length(rayStep * causticsWorldSize);
	float4 currentTransport = ParticleFluidInsideUv01(uv) ? SampleTransport(uv) : float4(0.0, 0.0, 0.0, 0.0);
	float previousDensity = SelectedDensity(currentTransport);
	bool inside = previousDensity >= 0.5;
	bool insideOuterBoundary = InsideOuterAnalyticBoundary(uv);
	bool insideInnerBoundary = InsideInnerAnalyticBoundary(uv);
	bool previousInsideOuterBoundary = insideOuterBoundary;
	bool previousInsideInnerBoundary = insideInnerBoundary;
	bool enteredBoundary = useEllipticalBounds == 0 || insideOuterBoundary;
	bool enteredTexture = ParticleFluidInsideUv01(uv);
	float causticLineEnergy = max(causticsRayBrightness, 0.0) * lightSampleWeight / max(causticsRaysPerPixel, 1);
	uint spectralSeed = id.x * 73856093u ^ id.y * 19349663u ^ (uint)causticsFrameIndex * 83492791u;
	int raysPerPixel = max(causticsRaysPerPixel, 1);
	int baseRay = (int)(id.x / (uint)raysPerPixel);
	int subRay = (int)(id.x - (uint)(baseRay * raysPerPixel));
	uint spectralRotationSeed = (uint)baseRay * 2654435761u ^ (uint)causticsFrameIndex * 2246822519u;
	float spectralOffset;
	float3 rayEnergy;
	InitSpectralRay(spectralSeed, spectralRotationSeed, lightSubRay, lightSubRayCount, lightMultiplier, lightTemperatureKelvin, lightDispersionScale, spectralOffset, rayEnergy);
	int currentPhase = MediumPhaseFromTransport(currentTransport, insideInnerBoundary);
	float3 mediumColour = AbsorptionColourFromTransport(currentTransport, currentPhase);
	float2 rayMotionUv = 0.0;
	bool hasRayMotion = false;
	int raySeed = (int)id.x + (int)id.y;
	bool rayIsRefractedOnly = true;
	float effectiveGlassIor = EffectiveAbsoluteIor(CausticsMaterialIor(2), spectralOffset);
	float effectiveFluidIor = EffectiveAbsoluteIor(CausticsMaterialIor(1), spectralOffset);
	int maxSteps = min(4096, (int)ceil(length(causticSize)) + causticsRaySteps);

	for (int stepIndex = 0; stepIndex < maxSteps; stepIndex++)
	{
		uv += rayStep;
		bool inTexture = ParticleFluidInsideUv01(uv);
		if (!inTexture)
		{
			if (enteredTexture && !inside)
			{
				return;
			}

			previousDensity = 0.0;
			continue;
		}

		enteredTexture = true;
		currentTransport = SampleTransport(uv);
		float density = SelectedDensity(currentTransport);
		insideOuterBoundary = InsideOuterAnalyticBoundary(uv);
		insideInnerBoundary = InsideInnerAnalyticBoundary(uv);

		if (useEllipticalBounds != 0 && previousInsideOuterBoundary != insideOuterBoundary)
		{
			bool enteringBoundary = !previousInsideOuterBoundary && insideOuterBoundary;
			float eta = enteringBoundary ? 1.0 / effectiveGlassIor : effectiveGlassIor;
			float2 normal = enteringBoundary
				? AnalyticSurfaceNormal(uv, rayDir, max(analyticBoundaryExpansion, 0.0))
				: -AnalyticSurfaceNormal(uv, rayDir, max(analyticBoundaryExpansion, 0.0));
			if (enteringBoundary)
			{
				rayIsRefractedOnly = rayIsRefractedOnly && CanRefract2D(rayDir, normal, eta);
				rayEnergy *= SurfaceTransmission(rayDir, normal, eta, CausticsMaterialReflectance(2));
				rayDir = Refract2D(rayDir, normal, eta);

				rayStep = rayDir / causticSize;
				uv += rayStep * 0.25;
				stepWorldDistance = length(rayStep * causticsWorldSize);
				insideOuterBoundary = true;
				insideInnerBoundary = InsideInnerAnalyticBoundary(uv);
			}
			else
			{
				rayEnergy *= SurfaceReflectance(rayDir, normal, eta, CausticsMaterialReflectance(2));
				rayDir = Reflect2D(rayDir, normal);
				rayIsRefractedOnly = false;
				rayStep = rayDir / causticSize;
				// The sampled position was outside. Resume slightly along the inward
				// reflected direction so the same crossing cannot fire repeatedly.
				uv += rayStep * 0.25;
				stepWorldDistance = length(rayStep * causticsWorldSize);
				insideOuterBoundary = true;
				insideInnerBoundary = InsideInnerAnalyticBoundary(uv);
				previousInsideOuterBoundary = true;
				previousInsideInnerBoundary = insideInnerBoundary;
				previousDensity = 0.0;
				continue;
			}
		}

		if (useEllipticalBounds != 0 && previousInsideInnerBoundary != insideInnerBoundary)
		{
			bool enteringFluid = !previousInsideInnerBoundary && insideInnerBoundary;
			float eta = enteringFluid ? effectiveGlassIor / effectiveFluidIor : effectiveFluidIor / effectiveGlassIor;
			float2 normal = enteringFluid
				? AnalyticSurfaceNormal(uv, rayDir, 0.0)
				: -AnalyticSurfaceNormal(uv, rayDir, 0.0);
			rayIsRefractedOnly = rayIsRefractedOnly && CanRefract2D(rayDir, normal, eta);
			rayEnergy *= SurfaceTransmission(rayDir, normal, eta, CausticsMaterialReflectance(2));
			rayDir = Refract2D(rayDir, normal, eta);

			rayStep = rayDir / causticSize;
			stepWorldDistance = length(rayStep * causticsWorldSize);
		}

		if (insideOuterBoundary)
		{
			enteredBoundary = true;
		}

		if (useEllipticalBounds != 0 && !insideOuterBoundary)
		{
			previousDensity = 0.0;
			previousInsideOuterBoundary = insideOuterBoundary;
			previousInsideInnerBoundary = insideInnerBoundary;
			continue;
		}

		int phase = MediumPhaseFromTransport(currentTransport, insideInnerBoundary);
		bool phaseChanged = phase != currentPhase;
		if (phaseChanged)
		{
			currentPhase = phase;
			mediumColour = AbsorptionColourFromTransport(currentTransport, currentPhase);
		}
		float absorption = 0.0;
		if (insideInnerBoundary)
		{
			absorption = CausticsMaterialAbsorption(currentPhase);
		}
		if (absorption > 0.0)
		{
			int colourStride = max(causticsColourSampleStride, 1);
			if (!phaseChanged && stepIndex % colourStride == 0)
			{
				float2 colourUv = uv + rayStep * (0.5 * (float)colourStride);
				float4 colourTransport = ParticleFluidInsideUv01(colourUv) ? SampleTransport(colourUv) : currentTransport;
				mediumColour = AbsorptionColourFromTransport(colourTransport, currentPhase);
			}

			float3 transmissionColour = max(mediumColour, float3(0.001, 0.001, 0.001));
			float3 spectralAbsorption = -log(transmissionColour) * absorption + absorption * 0.1;
			rayEnergy *= exp(-spectralAbsorption * stepWorldDistance);
		}
		if (!inside && previousDensity < 0.5 && density >= 0.5)
		{
			float2 normal = SurfaceNormal(uv, rayDir);
			float eta = EffectivePhaseEta(true, spectralOffset);
			int selectedPhase = causticsPhase == 0 ? 0 : 1;
			if (causticsMotionEnabled != 0)
			{
				float2 surfaceMotionUv = SamplePhaseVelocity(uv, selectedPhase) * max(causticsDeltaTime, 0.0) / max(causticsWorldSize, 0.0001);
				if (hasRayMotion)
				{
					rayMotionUv = lerp(rayMotionUv, surfaceMotionUv, 0.025);
				}
				else
				{
					rayMotionUv = surfaceMotionUv;
					hasRayMotion = true;
				}
			}
			float materialReflectance = PhaseReflectance(selectedPhase);
			float materialMetallic = PhaseMetallic(selectedPhase);
				float3 materialColour = materialMetallic > 0.0 ? RayColourFromTransport(currentTransport, selectedPhase) : float3(1.0, 1.0, 1.0);
			bool canTransmit = CanRefract2D(rayDir, normal, eta);
			float surfaceEnergy = causticsStochasticReflection != 0
				? 1.0
				: SurfaceTransmission(rayDir, normal, eta, materialReflectance);
			bool transmitted = ResolveSurfaceDirection(rayDir, rayEnergy, normal, uv, eta, materialReflectance, materialMetallic, materialColour, raySeed, stepIndex, subRay);
			rayIsRefractedOnly = rayIsRefractedOnly && transmitted && canTransmit;
			rayEnergy *= surfaceEnergy;
			rayStep = rayDir / causticSize;
			stepWorldDistance = length(rayStep * causticsWorldSize);
			inside = transmitted;
			density = transmitted ? density : 0.5 - 0.000001;
		}
		else if (inside && previousDensity >= 0.5 && density < 0.5)
		{
			float2 normal = -SurfaceNormal(uv, rayDir);
			float eta = EffectivePhaseEta(false, spectralOffset);
			int selectedPhase = causticsPhase == 0 ? 0 : 1;
			int otherPhase = selectedPhase == 0 ? 1 : 0;
			float materialReflectance = PhaseReflectance(otherPhase);
			float materialMetallic = PhaseMetallic(otherPhase);
			float3 materialColour = materialMetallic > 0.0 ? RayColourFromTransport(currentTransport, otherPhase) : float3(1.0, 1.0, 1.0);
			bool canTransmit = CanRefract2D(rayDir, normal, eta);
			float surfaceEnergy = causticsStochasticReflection != 0
				? 1.0
				: SurfaceTransmission(rayDir, normal, eta, materialReflectance);
			bool transmitted = ResolveSurfaceDirection(rayDir, rayEnergy, normal, uv, eta, materialReflectance, materialMetallic, materialColour, raySeed, stepIndex, subRay);
			rayIsRefractedOnly = rayIsRefractedOnly && transmitted && canTransmit;
			rayEnergy *= surfaceEnergy;
			rayStep = rayDir / causticSize;
			stepWorldDistance = length(rayStep * causticsWorldSize);
			inside = !transmitted;
			density = transmitted ? density : 0.5 + 0.000001;
		}

		if (causticLineEnergy > 0.0 && (useEllipticalBounds == 0 || insideOuterBoundary))
		{
			float pointAttenuation = pointLight != 0 ? PointLightAttenuation(UvToWorld(uv), launchAnchor, launchFalloff) : 1.0;
			float depositedEnergy = causticLineEnergy * pointAttenuation;
			AddCausticAtUv(uv, depositedEnergy, rayEnergy);
			if (causticsMotionEnabled != 0 && rayIsRefractedOnly)
			{
				float motionLuminance = dot(max(rayEnergy, 0.0), float3(0.2126, 0.7152, 0.0722));
				float motionEnergyWeight = sqrt(saturate(motionLuminance));
				AddCausticMotionAtUv(uv, depositedEnergy * motionEnergyWeight, rayMotionUv);
			}
		}

		previousDensity = density;
		previousInsideOuterBoundary = insideOuterBoundary;
		previousInsideInnerBoundary = insideInnerBoundary;
	}
}

[numthreads(16, 16, 1)]
void Resolve(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= causticSize.x || id.y >= causticSize.y)
	{
		return;
	}

	int2 pixel = int2(id.xy);
	uint index = AccumIndex(pixel);
	float3 caustic = float3((float)CausticAccum[index + 0], (float)CausticAccum[index + 1], (float)CausticAccum[index + 2]) / 65535.0;
	CausticResult[int2(id.xy)] = float4(caustic, 1.0);
	if (causticsMotionEnabled != 0)
	{
		float motionWeight = (float)CausticMotionAccum[index + 2];
		float2 motionUv = motionWeight > 0.0
			? float2((float)CausticMotionAccum[index + 0], (float)CausticMotionAccum[index + 1]) / max(motionWeight, 1.0) * (CausticMotionWeightScale / CausticMotionValueScale)
			: 0.0;
		float motionConfidence = saturate(motionWeight / CausticMotionWeightScale);
		CausticMotionResult[int2(id.xy)] = float4(motionUv, motionConfidence, 1.0);
	}
}
