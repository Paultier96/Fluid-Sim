#pragma kernel ClearProjectedShadowMap
#pragma kernel BuildProjectedShadowMap
#pragma kernel ResolveProjectedShadowMap

Texture2D<float4> CombinedTex;
RWStructuredBuffer<uint> ProjectedShadowMapAccum;
RWTexture2D<float4> ProjectedShadowMapResult;

#include "../../Shared/ParticleFluidCommon.hlsl"
#include "../../Shared/ParticleFluidPhaseClassification.hlsl"
#include "../../Shared/ParticleFluidCombinedSamplingCompute.hlsl"
int combinedWidth;
int combinedHeight;
float densityThreshold;
float phase0RenderBias;
int projectedShadowMapBinCount;
float2 projectedShadowMapDirection;
float2 projectedShadowSourceWorldCenter;
float2 projectedShadowSourceWorldSize;
float2 projectedShadowWorldCenter;
float2 projectedShadowWorldSize;

float ProjectedShadowHalfExtent(float2 axis, float2 worldSize)
{
	return max(0.5 * (abs(axis.x) * worldSize.x + abs(axis.y) * worldSize.y), 0.0001);
}

float2 ProjectedShadowSourceWorldFromPixel(int2 pixel)
{
	float2 uv = float2(
		combinedWidth > 1 ? (float)pixel.x / (combinedWidth - 1.0) : 0.5,
		combinedHeight > 1 ? (float)pixel.y / (combinedHeight - 1.0) : 0.5
	);
	return ParticleFluidWorldFromUv(uv, projectedShadowSourceWorldCenter, projectedShadowSourceWorldSize);
}

[numthreads(64, 1, 1)]
void ClearProjectedShadowMap(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= projectedShadowMapBinCount)
	{
		return;
	}

	ProjectedShadowMapAccum[id.x] = 0xffffffffu;
}

[numthreads(16, 16, 1)]
void BuildProjectedShadowMap(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= combinedWidth || id.y >= combinedHeight)
	{
		return;
	}

	float4 combined = ParticleFluidLoadCombinedPixel(CombinedTex, int2(id.xy), int2(combinedWidth, combinedHeight));
	if (ParticleFluidMaxPhaseDensity(combined) < densityThreshold)
	{
		return;
	}

	bool phase0CastsShadow = ParticleFluidPhase0Mask(combined, densityThreshold, phase0RenderBias) > 0.5;
	if (!phase0CastsShadow)
	{
		return;
	}

	float2 forward = length(projectedShadowMapDirection) > 0.0001 ? normalize(projectedShadowMapDirection) : float2(0.0, -1.0);
	float2 perp = float2(-forward.y, forward.x);
	float2 worldPos = ProjectedShadowSourceWorldFromPixel(int2(id.xy));
	float2 rel = worldPos - projectedShadowWorldCenter;
	float halfPerp = ProjectedShadowHalfExtent(perp, projectedShadowWorldSize);
	float halfForward = ProjectedShadowHalfExtent(forward, projectedShadowWorldSize);
	float binT = dot(rel, perp) / halfPerp * 0.5 + 0.5;
	if (binT < 0.0 || binT > 1.0)
	{
		return;
	}

	float depthT = saturate(dot(rel, forward) / halfForward * 0.5 + 0.5);
	uint bin = (uint)clamp((int)round(binT * max(projectedShadowMapBinCount - 1, 0)), 0, max(projectedShadowMapBinCount - 1, 0));
	uint encodedDepth = (uint)round(depthT * 4294967294.0);
	InterlockedMin(ProjectedShadowMapAccum[bin], encodedDepth);
}

[numthreads(64, 1, 1)]
void ResolveProjectedShadowMap(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= projectedShadowMapBinCount)
	{
		return;
	}

	uint encodedDepth = ProjectedShadowMapAccum[id.x];
	float valid = encodedDepth != 0xffffffffu ? 1.0 : 0.0;
	float depthT = valid > 0.0 ? ((float)encodedDepth / 4294967294.0) : 0.0;
	ProjectedShadowMapResult[int2(id.x, 0)] = float4(depthT, valid, 0.0, 1.0);
}
