#include "./FluidSim2DDebug.hlsl"

float2 CalculateDensity(float2 pos)
{
	int2 originCell = GetCell2D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsets, SpatialKeys, neighbourIndex)
	{
			float2 neighbourPos = PredictedPositions[neighbourIndex];
			float2 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			// Skip if not within radius
			if (sqrDstToNeighbour > sqrRadius) continue;

			// Calculate density and near density
			float dst = sqrt(sqrDstToNeighbour);
			density += SpikyKernelPow2(dst, smoothingRadius);
			nearDensity += SpikyKernelPow3(dst, smoothingRadius);
	}
	END_FOR_EACH_HASH_NEIGHBOR

	return float2(density, nearDensity);
}

float2 ExternalForces(float2 pos, float2 velocity, uint phase)
{
    float2 acceleration = float2(0, gravity);

    if (interactionInputStrength != 0)
    {
        float2 inputPointOffset = interactionInputPoint - pos;
        float sqrDst = dot(inputPointOffset, inputPointOffset);
        if (sqrDst < interactionInputRadius * interactionInputRadius)
        {
            float dst = sqrt(sqrDst);
            float edgeT = (dst / interactionInputRadius);
            float centreT = 1 - edgeT;
            float2 dirToCentre = inputPointOffset / dst;

            float gravityWeight = 1 - (centreT * saturate(interactionInputStrength / 10));
            acceleration = acceleration * gravityWeight + dirToCentre * centreT * interactionInputStrength;
            acceleration -= velocity * centreT;
        }
    }

	return acceleration + CalculateBoundaryRepulsion(pos) + CalculateWallFilmAcceleration(pos, phase);
}

[numthreads(NumThreads, 1, 1)]
void ApplyThermalBuoyancy(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;

	if (!IsFluidParticle(id.x))
	{
		ClearThermalBuoyancyDebug(id.x);
		return;
	}

	float2 pos = PredictedPositions[id.x];
	uint myPhase = Phases[id.x];
	int2 originCell = GetCell2D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;

	float weightedEnvDensitySum = 0;
	float weightSum = 0;

	FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsets, SpatialKeys, neighbourIndex)
	{
            if (neighbourIndex == id.x) continue;
            if (!IsFluidParticle(neighbourIndex)) continue;

			if (IsPhase(neighbourIndex, myPhase)) continue;

			float2 offset = PredictedPositions[neighbourIndex] - pos;
			float sqrDst = dot(offset, offset);
			if (sqrDst > sqrRadius || sqrDst == 0) continue;

			float dst = sqrt(sqrDst);
			float weight = SpikyKernelPow2(dst, smoothingRadius);
			float neighbourTargetDensity = ParticleTargetDensities[neighbourIndex];
			weightedEnvDensitySum += neighbourTargetDensity * weight;
			weightSum += weight;
	}
	END_FOR_EACH_HASH_NEIGHBOR

	float rho_i = ParticleTargetDensities[id.x];
	float rho_env = 0;

	if (weightSum > 1e-6)
	{
		rho_env = weightedEnvDensitySum / weightSum;
	}
	else
	{
		float otherPhaseDensitySum = 0;
		int otherPhaseCount = 0;
		for (int phase = 0; phase < NumPhases; phase++)
		{
			if (IsPhaseValue(myPhase, (uint)phase)) continue;
			otherPhaseDensitySum += PhaseTargetDensities[phase];
			otherPhaseCount++;
		}

		if (otherPhaseCount == 0)
		{
			ClearThermalBuoyancyDebug(id.x);
			return;
		}
		rho_env = otherPhaseDensitySum / otherPhaseCount;
	}

	float2 gravityDir = float2(0, gravity);
	float normalizedDensityContrast = (rho_env - rho_i) / max(rho_env, 1e-4);
	normalizedDensityContrast = clamp(normalizedDensityContrast, -buoyancyInversionClamp, buoyancyInversionClamp);
	float2 buoyancyAccel = -gravityDir * (buoyancyInversionStrength * normalizedDensityContrast);
	if (debugVectorFieldMode == 4)
	{
		float baseDensity = PhaseTargetDensities[myPhase];
		float thermalDensityContrast = (baseDensity - rho_i) / max(baseDensity, 1e-4);
		thermalDensityContrast = clamp(thermalDensityContrast, -buoyancyInversionClamp, buoyancyInversionClamp);
		DebugVectorData[id.x] = -gravityDir * (buoyancyInversionStrength * thermalDensityContrast);
	}
	Velocities[id.x] += buoyancyAccel * deltaTime;
}


void HandleCollisions(uint particleIndex)
{
	float2 pos = Positions[particleIndex];
	float2 vel = Velocities[particleIndex];

	if (useEllipticalBounds)
	{
		CollideWithEllipseBounds(pos, vel);
		CollideWithObstacleFloor(pos, vel);
	}
	else
	{
		CollideWithRectBounds(pos, vel);
	}

	Positions[particleIndex] = pos;
	Velocities[particleIndex] = vel;
}
[numthreads(NumThreads, 1, 1)]
void ExternalForces(uint3 id : SV_DispatchThreadID)
{
    if (!IsFluidParticle(id.x)) return;

    float2 externalAcceleration = ExternalForces(Positions[id.x], Velocities[id.x], Phases[id.x]);
    Velocities[id.x] += externalAcceleration * deltaTime;

    //const float predictionFactor = 1 / 120.0;//idk why
    PredictedPositions[id.x] = Positions[id.x] + Velocities[id.x] * deltaTime;
}

[numthreads(NumThreads,1,1)]
void UpdateSpatialHash (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numSpatialParticles) return;
	
	uint index = id.x;
	int2 cell = GetCell2D(PredictedPositions[index], smoothingRadius);
	uint hash = HashCell2D(cell);
	uint key = KeyFromHash(hash, numSpatialParticles);
	SpatialKeys[id.x] = key;
}

RWStructuredBuffer<float2> SortTarget_Positions;
RWStructuredBuffer<float2> SortTarget_PredictedPositions;
RWStructuredBuffer<float2> SortTarget_Velocities;
RWStructuredBuffer<uint> SortTarget_Phases;
RWStructuredBuffer<uint> SortTarget_IsGhost;
RWStructuredBuffer<uint> SortTarget_BlobIDs;
RWStructuredBuffer<float> SortTarget_Temperatures;
RWStructuredBuffer<float> SortTarget_ParticleTargetDensities;
StructuredBuffer<float2> SortTarget_PositionsRO;
StructuredBuffer<float2> SortTarget_PredictedPositionsRO;
StructuredBuffer<float2> SortTarget_VelocitiesRO;
StructuredBuffer<uint> SortTarget_PhasesRO;
StructuredBuffer<uint> SortTarget_IsGhostRO;
StructuredBuffer<uint> SortTarget_BlobIDsRO;
StructuredBuffer<float> SortTarget_TemperaturesRO;
StructuredBuffer<float> SortTarget_ParticleTargetDensitiesRO;

[numthreads(NumThreads,1,1)]
void Reorder (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numSpatialParticles) return;

	uint sortedIndex = SortedIndices[id.x];
	SortTarget_Positions[id.x] = PositionsRO[sortedIndex];
	SortTarget_PredictedPositions[id.x] = PredictedPositionsRO[sortedIndex];
	SortTarget_Velocities[id.x] = VelocitiesRO[sortedIndex];
	SortTarget_Phases[id.x] = PhasesRO[sortedIndex];
	SortTarget_IsGhost[id.x] = IsGhostRO[sortedIndex];
	SortTarget_BlobIDs[id.x] = BlobIDsRO[sortedIndex];
	SortTarget_Temperatures[id.x] = TemperaturesRO[sortedIndex];
	SortTarget_ParticleTargetDensities[id.x] = ParticleTargetDensitiesRO[sortedIndex];
}

[numthreads(NumThreads,1,1)]
void ReorderCopyback (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numSpatialParticles) return;

	Positions[id.x] = SortTarget_PositionsRO[id.x];
	PredictedPositions[id.x] = SortTarget_PredictedPositionsRO[id.x];
	Velocities[id.x] = SortTarget_VelocitiesRO[id.x];
	Phases[id.x] = SortTarget_PhasesRO[id.x];
	IsGhost[id.x] = SortTarget_IsGhostRO[id.x];
	BlobIDs[id.x] = SortTarget_BlobIDsRO[id.x];
	Temperatures[id.x] = SortTarget_TemperaturesRO[id.x];
	ParticleTargetDensities[id.x] = SortTarget_ParticleTargetDensitiesRO[id.x];
}

[numthreads(NumThreads, 1, 1)]
void InitializeBlobIDs(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;
	BlobIDsPrevious[id.x] = BlobIDs[id.x];
	BlobIDs[id.x] = id.x;
}

[numthreads(NumThreads, 1, 1)]
void PropagateBlobIDs(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;

	uint myPhase = Phases[id.x];
	float2 pos = PredictedPositions[id.x];
	int2 originCell = GetCell2D(pos, smoothingRadius);
	float blobConnectivityRadius = smoothingRadius * 2;
	float sqrBlobRadius = blobConnectivityRadius * blobConnectivityRadius;
	uint myPreviousBlob = BlobIDsPrevious[id.x];
	bool myWasUnassigned = IsUnassignedBlob(myPreviousBlob);

	uint minBlob = myWasUnassigned ? IgnoredPhaseBlobID : BlobIDs[id.x];

	// Phase 1 blobs are irrelevant - treat all phase 1 as one blob (ID = UINT_MAX)
	if (IsPhaseValue(myPhase, 1))
	{
		BlobIDsScratch[id.x] = IgnoredPhaseBlobID;
		return;
	}

	// Only propagate blob IDs within the wax phase.
	FOR_EACH_HASH_NEIGHBOR(originCell, numParticles, SpatialOffsets, SpatialKeys, neighbourIndex)
	{
			if (neighbourIndex == id.x) continue;

			if (!IsPhase(neighbourIndex, 0)) continue;

			float2 offset = PredictedPositions[neighbourIndex] - pos;
			float sqrDst = dot(offset, offset);
			if (sqrDst > sqrBlobRadius) continue;

			bool samePreviousBlob = IsSameBlob(BlobIDsPrevious[neighbourIndex], myPreviousBlob);
			bool neighbourWasUnassigned = IsUnassignedBlob(BlobIDsPrevious[neighbourIndex]);
			bool unassignedPreviousBlob = myWasUnassigned || neighbourWasUnassigned;
			if (!samePreviousBlob && !unassignedPreviousBlob && restrictBlobMergingToCoil)
			{
				float2 contactPos = (PredictedPositions[neighbourIndex] + pos) * 0.5;
				if (!IsInsideBlobMergeCoil(contactPos)) continue;
			}

			if (!myWasUnassigned && neighbourWasUnassigned)
			{
				continue;
			}

			uint neighbourBlob = BlobIDs[neighbourIndex];
			minBlob = min(minBlob, neighbourBlob);
	}
	END_FOR_EACH_HASH_NEIGHBOR

	BlobIDsScratch[id.x] = minBlob;
}

[numthreads(NumThreads, 1, 1)]
void CopyBlobIDs(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;
	BlobIDs[id.x] = BlobIDsScratch[id.x];
}

[numthreads(NumThreads, 1, 1)]
void CopyBlobIDsToPrevious(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;
	BlobIDsPrevious[id.x] = BlobIDs[id.x];
}

bool TryGetCarrierWedge(uint particleIndex, float2 pos, out float2 wedgeDir, out float wedgeAmount)
{
	wedgeDir = 0;
	wedgeAmount = 0;

	float carrierWedgeDistance = carrierWedgeDistanceMultiplier * smoothingRadius;
	if (carrierWedgeDistance <= 0) return false;
	if (carrierWedgeInterfaceOnly && length(ColorGradientsRO[particleIndex]) < carrierWedgeInterfaceThreshold) return false;

	float localStrengthMultiplier = IsInsideBlobMergeCoil(pos) ? saturate(carrierWedgeCoilStrengthMultiplier) : 1.0;
	if (localStrengthMultiplier <= 0) return false;

	float searchDistance = min(carrierWedgeDistance, smoothingRadius * 8.0);
	float sqrSearchDistance = searchDistance * searchDistance;
	int2 originCell = GetCell2D(pos, smoothingRadius);
	int cellRange = min((int)ceil(searchDistance / max(smoothingRadius, 1e-6)), 8);

	uint blobA = IgnoredPhaseBlobID;
	uint blobB = IgnoredPhaseBlobID;
	float2 weightedPosA = 0;
	float2 weightedPosB = 0;
	float weightA = 0;
	float weightB = 0;

	for (int y = -cellRange; y <= cellRange; y++)
	{
		for (int x = -cellRange; x <= cellRange; x++)
		{
			uint hash = HashCell2D(originCell + int2(x, y));
			uint key = KeyFromHash(hash, numSpatialParticles);
			uint currIndex = SpatialOffsets[key];

			while (currIndex < numSpatialParticles)
			{
				uint neighbourIndex = currIndex++;
				if (neighbourIndex == particleIndex) continue;
				if (SpatialKeys[neighbourIndex] != key) break;
				if (!IsFluidParticle(neighbourIndex)) continue;
				if (IsCarrierWedgePhase(Phases[neighbourIndex])) continue;

				uint neighbourBlob = BlobIDsRO[neighbourIndex];
				if (!IsAssignedBlob(neighbourBlob)) continue;

				float2 neighbourPos = PredictedPositions[neighbourIndex];
				float2 offset = neighbourPos - pos;
				float sqrDst = dot(offset, offset);
				if (sqrDst > sqrSearchDistance || sqrDst == 0) continue;

				float2 contactPos = (neighbourPos + pos) * 0.5;
				float contactStrengthMultiplier = IsInsideBlobMergeCoil(contactPos) ? saturate(carrierWedgeCoilStrengthMultiplier) : 1.0;
				if (contactStrengthMultiplier <= 0) continue;

				float dst = sqrt(sqrDst);
				float contactT = 1.0 - dst / max(searchDistance, 1e-6);
				float weight = contactT * contactT * contactStrengthMultiplier;

				if (IsSameBlob(neighbourBlob, blobA))
				{
					weightedPosA += neighbourPos * weight;
					weightA += weight;
				}
				else if (IsSameBlob(neighbourBlob, blobB))
				{
					weightedPosB += neighbourPos * weight;
					weightB += weight;
				}
				else if (weightA <= 0 || weight > weightA)
				{
					blobB = blobA;
					weightedPosB = weightedPosA;
					weightB = weightA;
					blobA = neighbourBlob;
					weightedPosA = neighbourPos * weight;
					weightA = weight;
				}
				else if (weightB <= 0 || weight > weightB)
				{
					blobB = neighbourBlob;
					weightedPosB = neighbourPos * weight;
					weightB = weight;
				}
			}
		}
	}

	if (weightA <= 1e-6 || weightB <= 1e-6 || IsSameBlob(blobA, blobB)) return false;

	float2 centroidA = weightedPosA / weightA;
	float2 centroidB = weightedPosB / weightB;
	float2 toA = centroidA - pos;
	float2 toB = centroidB - pos;
	float lenA = length(toA);
	float lenB = length(toB);
	if (lenA <= 1e-6 || lenB <= 1e-6) return false;

	float2 dirA = toA / lenA;
	float2 dirB = toB / lenB;
	float directionDot = dot(dirA, dirB);
	if (directionDot > carrierWedgeMaxDirectionDot) return false;

	wedgeDir = dirA + dirB;
	float wedgeLen = length(wedgeDir);
	if (wedgeLen <= 1e-6) return false;
	wedgeDir /= wedgeLen;

	float contactAmount = saturate(min(weightA, weightB));
	float angleAmount = saturate((carrierWedgeMaxDirectionDot - directionDot) / max(carrierWedgeMaxDirectionDot + 1.0, 1e-6));
	wedgeAmount = contactAmount * angleAmount * localStrengthMultiplier;
	return wedgeAmount > 0;
}

[numthreads(NumThreads, 1, 1)]
void ClearBlobSizes(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;
	BlobSizes[id.x] = 0;
}

[numthreads(NumThreads, 1, 1)]
void CountBlobSizes(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;
	if (!IsPhase(id.x, 0)) return;

	uint blobId = BlobIDs[id.x];
	if (blobId >= numParticles) return;

	uint previousCount;
	InterlockedAdd(BlobSizes[blobId], 1, previousCount);
}

[numthreads(NumThreads, 1, 1)]
void MarkSingleParticleBlobs(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;
	if (!IsPhase(id.x, 0)) return;

	uint blobId = BlobIDs[id.x];
	if (blobId >= numParticles || BlobSizes[blobId] <= 1)
	{
		BlobIDs[id.x] = UnassignedBlobID;
	}
}


[numthreads(NumThreads,1,1)]
void CalculateDensities (uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;

	float2 pos = PredictedPositions[id.x];
	Densities[id.x] = CalculateDensity(pos);
}

[numthreads(NumThreads,1,1)]
void CalculatePressureForce (uint3 id : SV_DispatchThreadID)
{
	if (!IsFluidParticle(id.x)) return;

	float density = Densities[id.x][0];
	float densityNear = Densities[id.x][1];
	uint myPhase = Phases[id.x];
    float pressure = PressureFromDensity(density, id.x);
	float nearPressure = NearPressureFromDensity(densityNear);
	float2 pressureForce = 0;
	
	float2 pos = PredictedPositions[id.x];
	int2 originCell = GetCell2D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;

	// Add a small epsilon to prevent division by near-zero density
	float epsilon = 0.0001;

	FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsets, SpatialKeys, neighbourIndex)
	{
			// Skip if looking at self
			if (neighbourIndex == id.x) continue;
			
			float2 neighbourPos = PredictedPositions[neighbourIndex];
			float2 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			// Skip if not within radius
			if (sqrDstToNeighbour > sqrRadius) continue;

			// Calculate pressure force
			float dst = sqrt(sqrDstToNeighbour);
			float2 dirToNeighbour = dst > 0 ? offsetToNeighbour / dst : float2(0, 1);

			float neighbourDensity = Densities[neighbourIndex][0];
			float neighbourNearDensity = Densities[neighbourIndex][1];
			uint neighbourPhase = Phases[neighbourIndex];
            float neighbourPressure = PressureFromDensity(neighbourDensity, neighbourIndex);

			float neighbourNearPressure = NearPressureFromDensity(neighbourNearDensity);

			float interaction = GetPhaseInteraction(myPhase, neighbourPhase);

			float sharedPressure = (pressure + neighbourPressure) * 0.5 * interaction;
			//float sharedPressure = (pressure / (density * density) + neighbourPressure / (neighbourDensity * neighbourDensity)) * interaction;
			float sharedNearPressure = (nearPressure + neighbourNearPressure) * 0.5 * interaction;

			pressureForce += dirToNeighbour * DerivativeSpikyPow2(dst, smoothingRadius) * sharedPressure /  max(neighbourDensity, epsilon);
			pressureForce += dirToNeighbour * DerivativeSpikyPow3(dst, smoothingRadius) * sharedNearPressure /  max(neighbourDensity, epsilon);
	}
	END_FOR_EACH_HASH_NEIGHBOR

    pressureForce += CalculateWallPressureSupportForce(pos, density, pressure, nearPressure, id.x, epsilon);

	float2 acceleration = pressureForce / max(density, epsilon);

	// Clamp acceleration magnitude to prevent explosive forces in a single step
	// float maxAcceleration = smoothingRadius / (deltaTime * deltaTime);
	// float accMag = length(acceleration);
	// if (accMag > maxAcceleration)
	//	acceleration = (acceleration / accMag) * maxAcceleration;

	Velocities[id.x] += acceleration * deltaTime;
}

[numthreads(NumThreads, 1, 1)]
void UpdateTemperature(uint3 id : SV_DispatchThreadID)
{
    if (IsInvalidParticle(id.x)) return;

    float2 pos = PredictedPositions[id.x];

    if (IsGhostParticle(id.x))
    {
        float heatSourceWeight = SampleHeatSourceWeight(pos);
        Temperatures[id.x] = lerp(ambientTemperature, heatSourceTemperature, heatSourceWeight);
        return;
    }

    float myTemp = Temperatures[id.x];
    uint myPhase = Phases[id.x];

    int2 originCell = GetCell2D(pos, smoothingRadius);
    float sqrRadius = smoothingRadius * smoothingRadius;

    // Diffusion: exchange heat with neighbors
    float diffusion = 0;
    float totalWeight = 0;

    FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsets, SpatialKeys, neighbourIndex)
    {
            if (neighbourIndex == id.x)
                continue;

            float2 neighbourPos = PredictedPositions[neighbourIndex];
            float2 offset = neighbourPos - pos;
            float sqrDst = dot(offset, offset);

            if (sqrDst > sqrRadius)
                continue;

            float dst = sqrt(sqrDst);
            float weight = SpikyKernelPow2(dst, smoothingRadius);
            float neighbourTemp = Temperatures[neighbourIndex];

            // Only diffuse within same phase - cross-phase heat transfer is slower
            uint neighbourPhase = Phases[neighbourIndex];
            float phaseWeight = IsPhaseValue(myPhase, neighbourPhase) ? 1.0 : crossPhaseThermalDiffusion;
            
            // Boost cooling to ghost particles at boundaries
            float ghostMultiplier = IsGhostParticle(neighbourIndex) ? ghostCoolingMultiplier : 1.0;

            diffusion += (neighbourTemp - myTemp) * weight * phaseWeight * ghostMultiplier;
            totalWeight += weight * phaseWeight;
    }
    END_FOR_EACH_HASH_NEIGHBOR

    float newTemp = myTemp;

    // Apply diffusion
    if (totalWeight > 0)
        newTemp += diffusion / totalWeight * PhaseThermalConductivity[myPhase] * deltaTime / PhaseSpecificHeatCapacity[myPhase];

    float heatCapacity = max(PhaseSpecificHeatCapacity[myPhase], 0.01);

    if (ambientCoolingRate > 0)
    {
        newTemp += (ambientTemperature - newTemp) * ambientCoolingRate * deltaTime / heatCapacity;
    }

    if (wallCoolingRate > 0)
    {
        float coolingRadius = (wallCoolingDistance > 0) ? wallCoolingDistance : smoothingRadius;
        float wallDist = GetNearestWallDistance(pos, true);

        if (wallDist >= 0 && wallDist < coolingRadius)
        {
            float wallT = 1.0 - saturate(wallDist / max(coolingRadius, 1e-6));
            newTemp += (ambientTemperature - newTemp) * wallCoolingRate * wallT * deltaTime / heatCapacity;
        }
    }

    // Heat source over source area. Elliptical sources use smooth radial falloff.
    float heatSourceWeight = SampleHeatSourceWeight(pos);
    
    if (heatSourceWeight > 0)
        newTemp += (heatSourceTemperature - newTemp) * heatSourceTransferRate * heatSourceWeight * deltaTime / heatCapacity;

    Temperatures[id.x] = newTemp;
}

[numthreads(NumThreads, 1, 1)]
void CalculateCohesion(uint3 id : SV_DispatchThreadID)
{
	if (!IsFluidParticle(id.x)) return;

	uint myPhase = Phases[id.x];
	float2 pos = PredictedPositions[id.x];
	int2 originCell = GetCell2D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;

	float2 cohesionForce = 0;

	FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsets, SpatialKeys, neighbourIndex)
	{
			if (neighbourIndex == id.x) continue;
            if (!IsFluidParticle(neighbourIndex)) continue;

			uint neighbourPhase = Phases[neighbourIndex];
			bool isOtherBlobSamePhase = IsPhaseValue(neighbourPhase, myPhase) && !IsSameBlob(BlobIDs[neighbourIndex], BlobIDs[id.x]);
			float cohesionStrength = GetPhaseCohesion(myPhase, neighbourPhase);
			if (isOtherBlobSamePhase)
			{
				cohesionStrength = blobBlobCohesion;
			}

			float2 neighbourPos = PredictedPositions[neighbourIndex];
			float2 offsetToNeighbour = neighbourPos - pos;
			float sqrDst = dot(offsetToNeighbour, offsetToNeighbour);

			if (sqrDst > sqrRadius || sqrDst == 0) continue;

			float dst = sqrt(sqrDst);
			float2 dirToNeighbour = offsetToNeighbour / dst;

			// Attractive in the mid-range, zero at very close range (near-pressure handles that)
			float normalizedDst = dst / smoothingRadius;
			//float cohesionKernel = normalizedDst * (1 - normalizedDst) * (1 - normalizedDst);
			float cohesionKernel = SpikyKernelPow2(dst, smoothingRadius);
			
			if (cohesionStrength != 0)
			{
				cohesionForce += dirToNeighbour * cohesionKernel * cohesionStrength;
			}
	}
	END_FOR_EACH_HASH_NEIGHBOR

	Velocities[id.x] += cohesionForce * deltaTime;
}

[numthreads(NumThreads, 1, 1)]
void ApplyCarrierWedgeForce(uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;
	bool debugNonCoalescence = debugVectorFieldMode == 2;
	if (debugNonCoalescence)
	{
		ClearDebugVectorData(id.x);
	}

	float carrierWedgeDistance = carrierWedgeDistanceMultiplier * smoothingRadius;
	if (carrierWedgeStrength <= 0 || carrierWedgeDistance <= 0) return;
	if (!IsFluidParticle(id.x)) return;
	if (!IsCarrierWedgePhase(Phases[id.x])) return;

	float2 pos = PredictedPositions[id.x];
	float2 wedgeDir;
	float wedgeAmount;
	if (!TryGetCarrierWedge(id.x, pos, wedgeDir, wedgeAmount)) return;
	float2 acceleration = wedgeDir * carrierWedgeStrength * wedgeAmount;
	float accelerationMag = length(acceleration);
	if (carrierWedgeMaxAcceleration > 0 && accelerationMag > carrierWedgeMaxAcceleration)
	{
		acceleration *= carrierWedgeMaxAcceleration / accelerationMag;
	}

	if (debugNonCoalescence)
	{
		DebugVectorData[id.x] = acceleration;
	}

	Velocities[id.x] += acceleration * deltaTime;
}

[numthreads(NumThreads,1,1)]
void CalculateViscosity (uint3 id : SV_DispatchThreadID)
{
	if (IsInvalidParticle(id.x)) return;

	if (!IsFluidParticle(id.x))
	{
		if (debugVisualizationMode == 3)
			ClearDebugData(id.x);
		return;
	}
	
	float2 pos = PredictedPositions[id.x];
	int2 originCell = GetCell2D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;

	float2 viscosityForce = 0;
	float2 velocity = Velocities[id.x];

	uint myPhase = Phases[id.x];
	float myTemp = Temperatures[id.x];
	float myViscosity = GetTemperatureAdjustedViscosity(myPhase, myTemp);
	float wedgeViscosityMultiplier = 1.0;
	if (IsCarrierWedgePhase(myPhase) && carrierWedgeViscosityMultiplier > 1.0)
	{
		float2 wedgeDir;
		float wedgeAmount;
		if (TryGetCarrierWedge(id.x, pos, wedgeDir, wedgeAmount))
		{
			wedgeViscosityMultiplier = lerp(1.0, carrierWedgeViscosityMultiplier, wedgeAmount);
		}
	}
	if (debugVisualizationMode == 3)
	{
		DebugData[id.x] = (myViscosity * wedgeViscosityMultiplier).xx;
	}


	FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsets, SpatialKeys, neighbourIndex)
	{
			// Skip if looking at self
			if (neighbourIndex == id.x) continue;
            if (!IsFluidParticle(neighbourIndex)) continue;
			
			float2 neighbourPos = PredictedPositions[neighbourIndex];
			float2 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			// Skip if not within radius
			if (sqrDstToNeighbour > sqrRadius) continue;

			uint neighbourPhase = Phases[neighbourIndex];
			float neighbourTemp = Temperatures[neighbourIndex];
			float neighbourViscosity = GetTemperatureAdjustedViscosity(neighbourPhase, neighbourTemp);
			float blendedViscosity = (myViscosity + neighbourViscosity) * 0.5;
			blendedViscosity *= wedgeViscosityMultiplier;
			bool differentPhase = !IsPhaseValue(neighbourPhase, myPhase);
			bool differentBlobSamePhase = !differentPhase && !IsSameBlob(BlobIDsRO[neighbourIndex], BlobIDsRO[id.x]);
			if (differentPhase || differentBlobSamePhase)
			{
				blendedViscosity *= interfaceViscosityMultiplier;
			}

			float dst = sqrt(sqrDstToNeighbour);
			float2 neighbourVelocity = Velocities[neighbourIndex];
			viscosityForce += (neighbourVelocity - velocity) * ViscosityKernel(dst, smoothingRadius) * blendedViscosity;
	}
	END_FOR_EACH_HASH_NEIGHBOR
	Velocities[id.x] += viscosityForce * deltaTime;
}

[numthreads(NumThreads, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID)
{
	if (!IsFluidParticle(id.x)) return;

	if ((coilVelocityDamping > 0 || coilAttractionStrength > 0) && (coilVelocityDampingPhase < 0 || IsPhaseValue(Phases[id.x], (uint)coilVelocityDampingPhase)))
	{
		float coilWeight = SampleBlobMergeCoilWeight(Positions[id.x]);
		if (coilWeight > 0)
		{
			float2 inwardDir = DirectionToBlobMergeCoilCenter(Positions[id.x]);
			float inwardLen = length(inwardDir);
			if (inwardLen > 0)
			{
				if (coilVelocityDamping > 0)
				{
					float outwardSpeed = max(0, -dot(Velocities[id.x], inwardDir));
					float dampedOutwardSpeed = outwardSpeed * exp(-coilVelocityDamping * coilWeight * deltaTime);
					Velocities[id.x] += inwardDir * (outwardSpeed - dampedOutwardSpeed);
				}
				if (coilAttractionStrength > 0)
				{
					Velocities[id.x] += inwardDir * coilAttractionStrength * coilWeight * deltaTime;
				}
			}
		}
	}

	Positions[id.x] += Velocities[id.x] * deltaTime;
	HandleCollisions(id.x);
}

[numthreads(NumThreads, 1, 1)]
void UpdateThermalExpansion(uint3 id : SV_DispatchThreadID)
{
    if (!IsFluidParticle(id.x)) return;

    uint phase = Phases[id.x];
    float baseDensity = PhaseTargetDensities[phase];
    float expansionCoeff = PhaseThermalExpansion[phase];
    float temp = Temperatures[id.x];

    // Density decreases as temperature rises above reference
    float thermalDensity = baseDensity * (1.0 - expansionCoeff * (temp - ambientTemperature));
    ParticleTargetDensities[id.x] = max(thermalDensity, baseDensity * 0.1); // prevent negative density
}

[numthreads(NumThreads, 1, 1)]
void ComputeColorGradients(uint3 id : SV_DispatchThreadID)
{
    if (IsInvalidParticle(id.x)) return;

    uint myPhase = Phases[id.x];
    uint myBlobId = BlobIDsRO[id.x];
    float2 pos = PredictedPositions[id.x];
    float density_i = max(Densities[id.x][0], 0.0001);
    int2 originCell = GetCell2D(pos, smoothingRadius);
    float sqrRadius = smoothingRadius * smoothingRadius;

    float2 gradC = 0;

    FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsets, SpatialKeys, j)
    {
            if (j == id.x) continue;

            float2 pos_j = PredictedPositions[j];
            float2 offset = pos_j - pos;
            float sqrDst = dot(offset, offset);
            if (sqrDst > sqrRadius || sqrDst == 0) continue;

            float dst = sqrt(sqrDst);
            float2 dir = offset / dst;

            float density_j = max(Densities[j][0], 0.0001);

			float dc = IsSameSurfaceTensionRegion(myPhase, myBlobId, Phases[j], BlobIDsRO[j]) ? 0.0 : -1.0;

            float gradW = DerivativeSpikyPow2(dst, smoothingRadius);

            gradC += (dc / density_j) * gradW * dir;
    }
    END_FOR_EACH_HASH_NEIGHBOR

    ColorGradients[id.x] = gradC;
	if (debugVisualizationMode == 1 || debugVisualizationMode == 0)
	{
		DebugData[id.x] = gradC;
	}
}

[numthreads(NumThreads, 1, 1)]
void CalculateCSF(uint3 id : SV_DispatchThreadID)
{
    if (IsInvalidParticle(id.x)) return;
    if (!IsFluidParticle(id.x))
    {
	    ClearInactiveCsfDebugOutputs(id.x);
	    return;
    };

    uint myPhase = PhasesRO[id.x];
    uint myBlobId = BlobIDsRO[id.x];
    float2 pos = PredictedPositions[id.x];

    int2 originCell = GetCell2D(pos, smoothingRadius);
    float sqrRadius = smoothingRadius * smoothingRadius;

    // 1. COLOR FIELD GRADIENT

    float2 gradC = ColorGradientsRO[id.x];

    float gradMag = length(gradC);


    ClearActiveCsfDebugOutputs(id.x);

    // Surface detection
    if (gradMag < surfaceTensionThreshold)
        return;

    float2 normal = gradC / gradMag;

	// 2. CURVATURE (divergence of normal)

	float curvature = 0;
	float blobSelfCurvature = 0;
	float sigmaWeightedSum = 0;
	float sigmaWeightSum = 0;

	FOR_EACH_HASH_NEIGHBOR(originCell, numSpatialParticles, SpatialOffsetsRO, SpatialKeysRO, j)
	{
			if (j == id.x) continue;

			float2 pos_j = PredictedPositions[j];
			float2 offset = pos_j - pos;
			float sqrDst = dot(offset, offset);
			if (sqrDst > sqrRadius || sqrDst == 0) continue;

			float dst = sqrt(sqrDst);
			float2 dir = offset / dst;

			float density_j = max(DensitiesRO[j][0], 0.0001);

			float gradW = DerivativeSpikyPow2(dst, smoothingRadius);

			float2 gradCj = ColorGradientsRO[j];
			float gjmag = length(gradCj);
			uint neighbourPhase = PhasesRO[j];
			bool neighbourIsGhost = IsGhostParticle(j);
			bool isSameBlob = IsSameBlob(BlobIDsRO[j], myBlobId);
			bool isSameSurfaceTensionRegion = IsSameSurfaceTensionRegion(myPhase, myBlobId, neighbourPhase, BlobIDsRO[j]);
			bool isOtherBlobSamePhase = !neighbourIsGhost && IsPhaseValue(neighbourPhase, myPhase) && !isSameBlob;
			float2 normal_j = (gjmag > 1e-6) ? gradCj / gjmag : normal;

			if (surfaceTensionInterfaceMode == 0 && isOtherBlobSamePhase)
			{
				continue;
			}

			float2 normal_j_for_curvature = isSameSurfaceTensionRegion ? normal_j : -normal_j;

			if (neighbourIsGhost)
			{
				float sigma_ij = blobBlobSurfaceTension;
				float sigmaWeight = abs(gradW) / density_j;
				sigmaWeightedSum += sigma_ij * sigmaWeight;
				sigmaWeightSum += sigmaWeight;
			}
			else if (!isSameSurfaceTensionRegion)
			{
				float sigmaWeight = abs(gradW) / density_j;
				sigmaWeightedSum += surfaceTension * sigmaWeight;
				sigmaWeightSum += sigmaWeight;
			}
			curvature += dot(normal_j_for_curvature - normal, dir) * gradW / density_j;
			blobSelfCurvature += dot(normal_j_for_curvature - normal, dir) * gradW / density_j;
	}
	END_FOR_EACH_HASH_NEIGHBOR

	float2 repulsionForce = 0;
	float nonCoalescenceRadius = PhaseNonCoalescenceRadiusMultiplier[myPhase] * smoothingRadius;
	float nonCoalescenceStrength = PhaseNonCoalescenceStrength[myPhase];
	if (nonCoalescenceRadius > 0 && nonCoalescenceStrength != 0)
	{
		float sqrNonCoalescenceRadius = nonCoalescenceRadius * nonCoalescenceRadius;
		int cellRange = min((int)ceil(nonCoalescenceRadius / max(smoothingRadius, 1e-6)), 8);
		for (int y = -cellRange; y <= cellRange; y++)
		{
			for (int x = -cellRange; x <= cellRange; x++)
			{
				uint hash = HashCell2D(originCell + int2(x, y));
				uint key = KeyFromHash(hash, numSpatialParticles);
				uint currIndex = SpatialOffsetsRO[key];

				while (currIndex < numSpatialParticles)
				{
					uint j = currIndex++;
					if (j == id.x) continue;

					if (SpatialKeysRO[j] != key) break;
					if (!IsFluidParticle(j)) continue;
					if (!IsPhaseRO(j, myPhase)) continue;
					if (IsSameBlob(BlobIDsRO[j], myBlobId)) continue;

					float2 pos_j = PredictedPositions[j];
					float2 offset = pos_j - pos;
					float sqrDst = dot(offset, offset);
					if (sqrDst > sqrNonCoalescenceRadius || sqrDst == 0) continue;

					float2 gradCj = ColorGradientsRO[j];
					if (length(gradCj) <= surfaceTensionThreshold) continue;

					float dst = sqrt(sqrDst);
					float2 dir = offset / dst;
					float2 contactPos = (pos_j + pos) * 0.5;
					float localStrengthMultiplier = IsInsideBlobMergeCoil(contactPos) ? saturate(carrierWedgeCoilStrengthMultiplier) : 1.0;
					if (localStrengthMultiplier <= 0) continue;
					float overlapT = 1.0 - dst / max(nonCoalescenceRadius, 1e-6);
					repulsionForce += -dir * nonCoalescenceStrength * localStrengthMultiplier * overlapT;
				}
			}
		}
	}

	curvature = -curvature;
	curvature = clamp(curvature, -maxSurfaceTensionCurvature, maxSurfaceTensionCurvature);
	blobSelfCurvature = -blobSelfCurvature;
	blobSelfCurvature = clamp(blobSelfCurvature, -maxSurfaceTensionCurvature, maxSurfaceTensionCurvature);
	DebugVectorSign[id.x] = curvature;

	if (debugVisualizationMode == 2)
	{
		DebugData[id.x] = curvature.xx;
	}
	
	// Step 3: apply surface tension force along normal, scaled by curvature.
	// Use the effective interfacial coefficient from cross-phase neighbors.
    float sigma = (sigmaWeightSum > 1e-6) ? (sigmaWeightedSum / sigmaWeightSum) : surfaceTension;

	float normalizedGradMag = gradMag * smoothingRadius;
	float2 surfaceTensionForce = -sigma * curvature * normal * normalizedGradMag;
	if (blobSelfSurfaceTension > 0 && (blobSelfSurfaceTensionPhase < 0 || IsPhaseValue(myPhase, (uint)blobSelfSurfaceTensionPhase)))
	{
		bool inMergeCoil = restrictBlobMergingToCoil && IsInsideBlobMergeCoil(pos);
		if (!inMergeCoil)
		{
			surfaceTensionForce += -blobSelfSurfaceTension * blobSelfCurvature * normal * normalizedGradMag;
		}
	}
	// apply both surface tension and any computed short-range repulsion
	if (debugVectorFieldMode == 1)
	{
		DebugVectorData[id.x] = surfaceTensionForce;
	}
	else if (debugVectorFieldMode == 2)
	{
		DebugVectorData[id.x] += repulsionForce;
	}
	else if (debugVectorFieldMode == 3)
	{
		DebugVectorData[id.x] = normal * curvature;
	}
	
	Velocities[id.x] += (surfaceTensionForce + repulsionForce) * deltaTime;
}
