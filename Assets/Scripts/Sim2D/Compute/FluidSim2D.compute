#pragma kernel CalculatePressureForce // 5
#pragma kernel CalculateViscosity    // 6
#pragma kernel ApplyThermalBuoyancy  // 7
#pragma kernel UpdatePositions       // 8
#pragma kernel UpdateThermalExpansion // 9
#pragma kernel UpdateTemperature     // 10
#pragma kernel CalculateCohesion // 17
#pragma kernel CalculateCSF // 18
#pragma kernel ComputeColorGradients // 19
